#!/usr/bin/env python3
"""marma-dialog — GNOME HIG Adwaita / Libadwaita Dialog Engine for Marma-Crypto Watermark.

Modeled after qes-dialog (/home/attor/legaltech/packages/qes-tools/bin/qes-dialog).
Provides native GTK4 + Libadwaita dialogs for:
1. select-medium: Selecting a key from ~/.secure_keys/ (.pfx, .p12, .key, .cer),
   hardware USB token (DepositSign / Almaz-1K / SecureToken-337), browsing disk,
   or entering a custom passphrase.
2. password: Entering password/PIN with 15-minute RAM session cache notice.
3. verify-report: Rich interactive verification window showing cryptographic and
   geometric invariants (9 triangles, bilateral symmetry, SHA-256 / HMAC-SHA256)
   with a one-click button to generate & open the official PDF Verification Protocol.
"""
from __future__ import annotations

import argparse
import json
import os
from pathlib import Path
import subprocess
import sys


def find_icon_path(name: str) -> str | None:
    """Find an icon in the system or Papirus theme."""
    candidates = [
        "/usr/share/icons/hicolor/scalable/apps/marma-crypto-watermark.svg",
        os.path.expanduser(f"~/.local/share/icons/Papirus/48x48/mimetypes/{name}.svg"),
        os.path.expanduser(f"~/.local/share/icons/Papirus/48x48/status/{name}.svg"),
        os.path.expanduser(f"~/.local/share/icons/Papirus/48x48/apps/{name}.svg"),
        f"/usr/share/icons/Papirus/48x48/mimetypes/{name}.svg",
        f"/usr/share/icons/Papirus/48x48/status/{name}.svg",
        f"/usr/share/icons/Papirus/48x48/apps/{name}.svg",
    ]
    for c in candidates:
        if os.path.isfile(c):
            return c
    return None


