#!/bin/sh
set -e

if [ "$1" = "remove" ] || [ "$1" = "purge" ] || [ "$1" = "deconfigure" ]; then
    # Деінсталяція Native Messaging Host для веб-браузерів
    if [ -x "/opt/iit/eu/sw/euscpnmh" ]; then
        /opt/iit/eu/sw/euscpnmh /unistall 2>/dev/null || true
    fi
    rm -f /etc/opt/chrome/native-messaging-hosts/ua.com.iit.eusign.nmh.json \
          /etc/chromium/native-messaging-hosts/ua.com.iit.eusign.nmh.json \
          /usr/lib/mozilla/native-messaging-hosts/ua.com.iit.eusign.nmh.json \
          /etc/brave/native-messaging-hosts/ua.com.iit.eusign.nmh.json \
          /etc/opt/edge/native-messaging-hosts/ua.com.iit.eusign.nmh.json 2>/dev/null || true
    rm -f /usr/lib/mozilla/plugins/npeuscp.so 2>/dev/null || true

    # Видалення глобальних бінарних обгорток
    rm -f /usr/bin/qes-sign \
          /usr/bin/qes-verify \
          /usr/bin/qes-cert \
          /usr/bin/qes-encrypt \
          /usr/bin/qes-decrypt \
          /usr/bin/qes-export-cert \
          /usr/bin/qes-pdf-court \
          /usr/bin/qes-agent \
          /usr/bin/qes-ocr \
          /usr/bin/qes-config \
          /usr/bin/qes-tool \
          /usr/bin/qes-tools \
          /usr/bin/euscpnmh 2>/dev/null || true

    # Видалення системних PKCS#11 посилань
    rm -f /usr/lib/pkcs11/pkcs11-almaz1k.so \
          /usr/lib/pkcs11/pkcs11-crystal1k.so \
          /usr/lib/pkcs11/pkcs11-securetoken337.so \
          /usr/lib/pkcs11/libeuscpt.so 2>/dev/null || true

    # Видалення скриптів Nautilus з /etc/skel
    rm -rf "/etc/skel/.local/share/nautilus/scripts/🔐 КЕП та Безпека" \
           "/etc/skel/.local/share/nautilus/scripts/🔐 QES & Security" 2>/dev/null || true

    # Видалення скриптів Nautilus з домашніх каталогів користувачів
    for user_home in /home/*; do
        if [ -d "$user_home" ]; then
            rm -rf "$user_home/.local/share/nautilus/scripts/🔐 КЕП та Безпека" \
                   "$user_home/.local/share/nautilus/scripts/🔐 QES & Security" 2>/dev/null || true
        fi
    done

    if [ -n "${SUDO_USER:-}" ]; then
        sudo_home=$(getent passwd "$SUDO_USER" | cut -d: -f6)
        if [ -n "$sudo_home" ] && [ -d "$sudo_home" ]; then
            rm -rf "$sudo_home/.local/share/nautilus/scripts/🔐 КЕП та Безпека" \
                   "$sudo_home/.local/share/nautilus/scripts/🔐 QES & Security" 2>/dev/null || true
        fi
    fi

    # Перезавантаження процесу Nautilus для миттєвого оновлення меню
    pkill -x nautilus 2>/dev/null || true
fi

exit 0
