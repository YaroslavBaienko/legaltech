#!/usr/bin/env python3
"""
qes-cert — Автономний інспектор сертифікатів КНЕДП / АЦСК (X.509, ДСТУ 4145, RSA, ECDSA).
Zero-Telemetry | 100% Offline-First | Захист адвокатської таємниці та персональних даних.

Підтримує формати:
  - Бінарні сертифікати X.509 DER (.cer, .crt, .der)
  - Текстові сертифікати PEM (.pem, .crt)
  - Пакети ланцюжків сертифікатів PKCS#7 (.p7b, .p7c)
"""

import argparse
import binascii
import html
import json
import os
import re
import shutil
import subprocess
import sys
from datetime import datetime, timezone
from pathlib import Path
from typing import Any, Dict, List, Optional, Tuple

try:
    from cryptography import x509
    from cryptography.hazmat.primitives import hashes
    from cryptography.hazmat.primitives.serialization import pkcs7, Encoding
except ImportError:
    sys.stderr.write("Помилка: бібліотеку 'cryptography' не знайдено. Встановіть python3-cryptography.\n")
    sys.exit(1)


def esc(val: Any) -> str:
    """Safely escapes any text for Pango/XML markup in Zenity dialogs."""
    return html.escape(str(val if val is not None else ""), quote=True)


def get_qes_lang() -> str:
    cfg = Path.home() / ".config" / "qes" / "config.json"
    if cfg.is_file():
        try:
            with open(cfg, "r", encoding="utf-8") as f:
                data = json.load(f)
                if data.get("lang") == "en":
                    return "en"
                if data.get("lang") in ("uk", "ua"):
                    return "uk"
        except Exception:
            pass
    l = os.environ.get("LC_ALL") or os.environ.get("LC_MESSAGES") or os.environ.get("LANG") or ""
    return "uk" if l.lower().startswith("uk") else "en"


