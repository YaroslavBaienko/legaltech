#!/usr/bin/env bash
# ==============================================================================
# qes-config — Керування конфігурацією та мовою інтерфейсу QES Tools (UA/EN)
# CLI configuration & language switcher for QES Tools (Nautilus menus & CLI)
# ==============================================================================
set -euo pipefail

CLR_RESET="\033[0m"
CLR_BOLD="\033[1m"
CLR_GREEN="\033[32m"
CLR_CYAN="\033[36m"
CLR_YELLOW="\033[33m"
CLR_RED="\033[31m"
CLR_GRAY="\033[90m"

declare -A SCRIPTS_UK=(
  ["0_help.sh"]="📖 Довідка та Інструкції КЕП"
  ["1_sign_pades.sh"]="✍️ Підписати (PAdES PDF зі штампом та QR)"
  ["1b_sign_pades_no_stamp.sh"]="✍️ Підписати (PAdES PDF без штампу та QR)"
  ["2_sign_p7s.sh"]="✍️ Підписати (Відокремлений підпис .p7s)"
  ["3_sign_asice.sh"]="📦 Підписати (Пакетний контейнер ASiC-E)"
  ["4_verify.sh"]="🔍 Перевірити підпис КЕП"
  ["5_encrypt_self.sh"]="🛡️ Зашифрувати в особистий сейф (.enc)"
  ["6_encrypt_recipient.sh"]="📨 Зашифрувати для адресата (.enc)"
  ["7_decrypt.sh"]="🔓 Розшифрувати особистим КЕП"
  ["8_export_cert.sh"]="📤 Експортувати мій відкритий сертифікат (.cer)"
  ["9_pdf_court.sh"]="⚖️ Оптимізувати PDF для Е-Суду"
  ["10_append_signature.sh"]="✍️ Додати другий підпис (Мультипідпис)"
  ["11_lock_session.sh"]="🔒 Скинути кеш пароля (Заблокувати)"
  ["12_ocr_court.sh"]="👁️ Розпізнати текст OCR (Е-Суд)"
  ["13_view_cert.sh"]="📜 Переглянути сертифікат КНЕДП"
  ["14_ocr_english.sh"]="👁️ Розпізнати текст OCR (🇬🇧 Чиста Англійська)"
)

declare -A SCRIPTS_EN=(
  ["0_help.sh"]="📖 Help & QES Documentation"
  ["1_sign_pades.sh"]="✍️ Sign (PAdES PDF with Stamp & QR)"
  ["1b_sign_pades_no_stamp.sh"]="✍️ Sign (PAdES PDF without Stamp & QR)"
  ["2_sign_p7s.sh"]="✍️ Sign (Detached Signature .p7s)"
  ["3_sign_asice.sh"]="📦 Sign (Package Container ASiC-E)"
  ["4_verify.sh"]="🔍 Verify QES Signature"
  ["5_encrypt_self.sh"]="🛡️ Encrypt to Personal Vault (.enc)"
  ["6_encrypt_recipient.sh"]="📨 Encrypt for Recipient (.enc)"
  ["7_decrypt.sh"]="🔓 Decrypt with Personal Key"
  ["8_export_cert.sh"]="📤 Export Public Certificate (.cer)"
  ["9_pdf_court.sh"]="⚖️ Optimize PDF for Court"
  ["10_append_signature.sh"]="✍️ Add Secondary Signature (Multi-Sign)"
  ["11_lock_session.sh"]="🔒 Lock Session (Clear Password Cache)"
  ["12_ocr_court.sh"]="👁️ OCR Text Recognition (Court PDF)"
  ["13_view_cert.sh"]="📜 View CA Certificate Details"
  ["14_ocr_english.sh"]="👁️ OCR Text Recognition (🇬🇧 English)"
)

FOLDER_UK="🔐 КЕП та Безпека"
FOLDER_EN="🔐 QES & Security"

# Find directory containing canonical source scripts
find_source_scripts_dir() {
    local candidate_dirs=(
        "/usr/share/qes-tools/nautilus-scripts"
        "/usr/share/nautilus-scripts"
        "$(cd "$(dirname "${BASH_SOURCE[0]}")/../nautilus-scripts" 2>/dev/null && pwd || true)"
        "$(cd "$(dirname "${BASH_SOURCE[0]}")/../../nautilus-scripts" 2>/dev/null && pwd || true)"
        "/home/attor/legaltech/packages/qes-tools/nautilus-scripts"
        "/home/attor/ai-debian-admin/tools/nautilus-scripts"
    )
    for d in "${candidate_dirs[@]}"; do
        if [[ -n "$d" && -d "$d" && -f "$d/1_sign_pades.sh" ]]; then
            echo "$d"
            return 0
        fi
    done
    return 1
}

# Read current user config
get_configured_lang() {
    local cfg="$HOME/.config/qes/config.json"
    if [[ -f "$cfg" ]]; then
        local l
        l=$(grep -o '"lang"[[:space:]]*:[[:space:]]*"[^"]*"' "$cfg" 2>/dev/null | cut -d'"' -f4 || true)
        if [[ -n "$l" ]]; then
            echo "$l"
            return 0
        fi
    fi
    echo "auto"
}

# Detect effective language
get_effective_lang() {
    local mode="${1:-$(get_configured_lang)}"
    if [[ "$mode" == "en" ]]; then
        echo "en"
        return 0
    fi
    if [[ "$mode" == "uk" || "$mode" == "ua" ]]; then
        echo "uk"
        return 0
    fi

    # Auto-detection from environment
    local l="${LC_ALL:-${LC_MESSAGES:-${LANG:-}}}"
    if [[ -z "$l" && -f /etc/default/locale ]]; then
        l=$(grep -E '^(LANG|LC_MESSAGES)=' /etc/default/locale | head -n1 | cut -d= -f2 | tr -d '"' || true)
    fi
    if [[ "${l,,}" =~ ^uk ]]; then
        echo "uk"
    else
        echo "en"
    fi
}

deploy_nautilus_scripts_for_dir() {
    local target_home="$1"
    local effective_lang="$2"
    local src_dir="$3"
    local target_base="$target_home/.local/share/nautilus/scripts"

    mkdir -p "$target_base"

    if [[ "$effective_lang" == "en" ]]; then
        # Remove Ukrainian folder if present
        rm -rf "$target_base/$FOLDER_UK"
        local target_folder="$target_base/$FOLDER_EN"
        mkdir -p "$target_folder"
        for script_file in "${!SCRIPTS_EN[@]}"; do
            if [[ -f "$src_dir/$script_file" ]]; then
                local display_name="${SCRIPTS_EN[$script_file]}"
                cp "$src_dir/$script_file" "$target_folder/$display_name"
                chmod 0755 "$target_folder/$display_name"
            fi
        done
        # Copy hidden helper
        if [[ -f "$src_dir/_i18n.sh" ]]; then
            cp "$src_dir/_i18n.sh" "$target_folder/.i18n.sh"
            chmod 0755 "$target_folder/.i18n.sh"
        fi
    else
        # Remove English folder if present
        rm -rf "$target_base/$FOLDER_EN"
        local target_folder="$target_base/$FOLDER_UK"
        mkdir -p "$target_folder"
        for script_file in "${!SCRIPTS_UK[@]}"; do
            if [[ -f "$src_dir/$script_file" ]]; then
                local display_name="${SCRIPTS_UK[$script_file]}"
                cp "$src_dir/$script_file" "$target_folder/$display_name"
                chmod 0755 "$target_folder/$display_name"
            fi
        done
        # Copy hidden helper
        if [[ -f "$src_dir/_i18n.sh" ]]; then
            cp "$src_dir/_i18n.sh" "$target_folder/.i18n.sh"
            chmod 0755 "$target_folder/.i18n.sh"
        fi
    fi
}

save_user_config() {
    local mode="$1"
    local cfg_dir="$HOME/.config/qes"
    mkdir -p "$cfg_dir"
    cat > "$cfg_dir/config.json" << EOF
{
  "lang": "$mode"
}
EOF
}

show_status() {
    local cfg_mode
    cfg_mode=$(get_configured_lang)
    local eff_lang
    eff_lang=$(get_effective_lang "$cfg_mode")
    local sys_locale="${LANG:-not set}"

    local scripts_dir="$HOME/.local/share/nautilus/scripts"
    local active_folder="None"
    if [[ -d "$scripts_dir/$FOLDER_UK" ]]; then
        active_folder="$FOLDER_UK (Українська)"
    elif [[ -d "$scripts_dir/$FOLDER_EN" ]]; then
        active_folder="$FOLDER_EN (English)"
    fi

    echo -e "\n${CLR_BOLD}${CLR_CYAN}╔═══════════════════════════════════════════════════════════════════════════════════════╗${CLR_RESET}"
    echo -e "${CLR_BOLD}${CLR_CYAN}║ НАЛАШТУВАННЯ ТА ЛОКАЛІЗАЦІЯ QES TOOLS / CONFIGURATION & LOCALE${CLR_RESET}"
    echo -e "${CLR_CYAN}╟───────────────────────────────────────────────────────────────────────────────────────╢${CLR_RESET}"
    echo -e "${CLR_CYAN}║ • Режим конфігурації / Config mode: ${CLR_BOLD}${CLR_GREEN}${cfg_mode}${CLR_RESET}"
    echo -e "${CLR_CYAN}║ • Активна мова / Effective language: ${CLR_BOLD}${CLR_YELLOW}${eff_lang}${CLR_RESET} ($([ "$eff_lang" = "uk" ] && echo "Українська 🇺🇦" || echo "English 🇬🇧"))"
    echo -e "${CLR_CYAN}║ • Локаль системи / System locale:    ${CLR_GRAY}${sys_locale}${CLR_RESET}"
    echo -e "${CLR_CYAN}║ • Меню Nautilus / Active folder:     ${CLR_BOLD}${CLR_GREEN}${active_folder}${CLR_RESET}"
    echo -e "${CLR_BOLD}${CLR_CYAN}╚═══════════════════════════════════════════════════════════════════════════════════════╝${CLR_RESET}\n"
}

show_help() {
    echo -e "
${CLR_BOLD}${CLR_CYAN}qes-config — Керування конфігурацією та мовою інтерфейсу QES Tools${CLR_RESET}

${CLR_BOLD}ВИКОРИСТАННЯ / USAGE:${CLR_RESET}
  qes-config [ОПЦІЇ / OPTIONS]

${CLR_BOLD}ОПЦІЇ / OPTIONS:${CLR_RESET}
  ${CLR_GREEN}--lang uk | ua${CLR_RESET}      Встановити українську мову інтерфейсу (меню: '${FOLDER_UK}')
  ${CLR_GREEN}--lang en${CLR_RESET}           Set English interface language (menu: '${FOLDER_EN}')
  ${CLR_GREEN}--lang auto${CLR_RESET}         Автовизначення за мовою системи ($LANG) / Auto-detect locale
  ${CLR_GREEN}--status${CLR_RESET}            Показати поточні налаштування / Show current configuration
  ${CLR_GREEN}--refresh${CLR_RESET}           Перевстановити скрипти Nautilus / Re-deploy scripts
  ${CLR_GREEN}--all-users${CLR_RESET}         Розгорнути для всіх користувачів системи (потрібні права root)
  ${CLR_GREEN}-h, --help${CLR_RESET}          Показати цю довідку / Show help

${CLR_BOLD}ПРИКЛАДИ / EXAMPLES:${CLR_RESET}
  qes-config --lang en        # Switch to English
  qes-config --lang uk        # Перемкнути на українську
  qes-config --status         # Перевірити поточний стан
"
}

main() {
    local cmd="${1:---status}"
    local target_lang=""
    local all_users=false

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --lang)
                target_lang="${2:-}"
                shift 2 || true
                ;;
            --status)
                show_status
                return 0
                ;;
            --refresh)
                target_lang="$(get_configured_lang)"
                shift
                ;;
            --all-users)
                all_users=true
                shift
                ;;
            -h|--help|help)
                show_help
                return 0
                ;;
            *)
                echo -e "${CLR_RED}Невідомий параметр: $1. Використовуйте qes-config --help.${CLR_RESET}"
                return 1
                ;;
        esac
    done

    if [[ -z "$target_lang" ]]; then
        show_status
        return 0
    fi

    # Validate language
    case "${target_lang,,}" in
        uk|ua)
            target_lang="uk"
            ;;
        en)
            target_lang="en"
            ;;
        auto)
            target_lang="auto"
            ;;
        *)
            echo -e "${CLR_RED}Помилка: невідома мова '${target_lang}'. Допустимі значення: uk, en, auto.${CLR_RESET}"
            return 1
            ;;
    esac

    local src_dir
    src_dir=$(find_source_scripts_dir || true)
    if [[ -z "$src_dir" ]]; then
        echo -e "${CLR_RED}Помилка: не знайдено каталог вихідних скриптів Nautilus.${CLR_RESET}"
        return 1
    fi

    if [[ "$all_users" == true ]]; then
        # System-wide installation
        echo -e "${CLR_YELLOW}Розгортання налаштувань для всіх користувачів системи (режим: ${target_lang})...${CLR_RESET}"
        
        # /etc/skel
        local eff_skel
        eff_skel=$(get_effective_lang "$target_lang")
        deploy_nautilus_scripts_for_dir "/etc/skel" "$eff_skel" "$src_dir"

        for u_home in /home/*; do
            if [[ -d "$u_home" ]]; then
                local u
                u=$(basename "$u_home")
                if id "$u" >/dev/null 2>&1; then
                    local eff_u
                    eff_u=$(get_effective_lang "$target_lang")
                    deploy_nautilus_scripts_for_dir "$u_home" "$eff_u" "$src_dir"
                    chown -R "$u:" "$u_home/.local/share/nautilus/scripts" 2>/dev/null || true
                fi
            fi
        done
        echo -e "${CLR_GREEN}✅ Успішно розгорнуто для всіх користувачів.${CLR_RESET}"
        pkill -x nautilus 2>/dev/null || true
        return 0
    fi

    # Single user setup
    save_user_config "$target_lang"
    local eff_lang
    eff_lang=$(get_effective_lang "$target_lang")
    deploy_nautilus_scripts_for_dir "$HOME" "$eff_lang" "$src_dir"

    # Reload Nautilus
    pkill -x nautilus 2>/dev/null || true
    if command -v nautilus >/dev/null 2>&1; then
        nautilus -q 2>/dev/null || true
    fi

    if [[ "$eff_lang" == "en" ]]; then
        echo -e "\n${CLR_GREEN}✅ Language set to English (en).${CLR_RESET}"
        echo -e "Nautilus context menu updated to: ${CLR_BOLD}${CLR_CYAN}${FOLDER_EN}${CLR_RESET}\n"
    else
        echo -e "\n${CLR_GREEN}✅ Встановлено українську мову (uk).${CLR_RESET}"
        echo -e "Меню Nautilus оновлено на: ${CLR_BOLD}${CLR_CYAN}${FOLDER_UK}${CLR_RESET}\n"
    fi
}

main "$@"
