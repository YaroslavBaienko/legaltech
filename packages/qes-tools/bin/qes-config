ORDERED_CATEGORIES_UK=(
  "✍️ Підписання"
  "🔍 Перевірка та Сертифікати"
  "🛡️ Шифрування та Сейф"
  "⚖️ Судові документи та OCR"
  "⚙️ Керування та Довідка"
)

declare -A CATEGORIES_UK=(
  ["✍️ Підписання"]="1_sign_pades.sh:Підписати PDF (зі штампом та QR)|1b_sign_pades_no_stamp.sh:Підписати PDF (без штампа)|2_sign_p7s.sh:Підписати окремим файлом (.p7s)|3_sign_asice.sh:Пакетний контейнер (ASiC-E)|10_append_signature.sh:Додати другий підпис (Мультипідпис)|15_upgrade_ltv.sh:🔏 Додати архівну мітку LTV (PAdES-LTA, 25 років)"
  ["🔍 Перевірка та Сертифікати"]="4_verify.sh:Перевірити підпис КЕП|15_upgrade_ltv.sh:🔏 Додати архівну мітку LTV (PAdES-LTA, 25 років)|13_view_cert.sh:Переглянути сертифікат КНЕДП|8_export_cert.sh:Експортувати відкритий сертифікат (.cer)"
  ["🛡️ Шифрування та Сейф"]="5_encrypt_self.sh:Зашифрувати в особистий сейф (.enc)|6_encrypt_recipient.sh:Зашифрувати для адресата (.enc)|7_decrypt.sh:Розшифрувати особистим КЕП"
  ["⚖️ Судові документи та OCR"]="9_pdf_court.sh:Оптимізувати PDF для Е-Суду|12_ocr_court.sh:Розпізнати текст OCR (Е-Суд)|14_ocr_english.sh:Розпізнати текст OCR (Англійська мова)"
  ["⚙️ Керування та Довідка"]="11_lock_session.sh:Скинути кеш пароля (Заблокувати)|0_help.sh:Довідка та Інструкції КЕП"
)

ORDERED_CATEGORIES_EN=(
  "✍️ Signing"
  "🔍 Verification & Certificates"
  "🛡️ Encryption & Vault"
  "⚖️ Court & OCR"
  "⚙️ Management & Help"
)

declare -A CATEGORIES_EN=(
  ["✍️ Signing"]="1_sign_pades.sh:Sign PDF (with Stamp & QR)|1b_sign_pades_no_stamp.sh:Sign PDF (without Stamp & QR)|2_sign_p7s.sh:Detached Signature (.p7s)|3_sign_asice.sh:Package Container (ASiC-E)|10_append_signature.sh:Add Secondary Signature (Multi-Sign)|15_upgrade_ltv.sh:🔏 Upgrade to Archival LTV (PAdES-LTA, 25 Years)"
  ["🔍 Verification & Certificates"]="4_verify.sh:Verify QES Signature|15_upgrade_ltv.sh:🔏 Upgrade to Archival LTV (PAdES-LTA, 25 Years)|13_view_cert.sh:View CA Certificate Details|8_export_cert.sh:Export Public Certificate (.cer)"
  ["🛡️ Encryption & Vault"]="5_encrypt_self.sh:Encrypt to Personal Vault (.enc)|6_encrypt_recipient.sh:Encrypt for Recipient (.enc)|7_decrypt.sh:Decrypt with Personal Key"
  ["⚖️ Court & OCR"]="9_pdf_court.sh:Optimize PDF for Court|12_ocr_court.sh:OCR Text Recognition (Court PDF)|14_ocr_english.sh:OCR Text Recognition (English)"
  ["⚙️ Management & Help"]="11_lock_session.sh:Lock Session (Clear Password Cache)|0_help.sh:Help & QES Documentation"
)

FOLDER_UK="🔐 КЕП та Безпека"
FOLDER_EN="🔐 QES & Security"

# Find directory containing canonical source scripts
find_source_scripts_dir() {
    local real_bin
    real_bin="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || realpath "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")"
    local bin_parent
    bin_parent="$(cd "$(dirname "$real_bin")/.." 2>/dev/null && pwd || true)"

    local candidate_dirs=(
        "${QES_SOURCE_SCRIPTS_DIR:-}"
        "$bin_parent/nautilus-scripts"
        "$bin_parent/../nautilus-scripts"
        "$(cd "$(dirname "${BASH_SOURCE[0]}")/../nautilus-scripts" 2>/dev/null && pwd || true)"
        "/usr/share/qes-tools/nautilus-scripts"
        "/usr/share/nautilus-scripts"
    )
    for d in "${candidate_dirs[@]}"; do
        if [[ -n "$d" && -d "$d" && -f "$d/1_sign_pades.sh" ]]; then
            echo "$d"
            return 0
        fi
    done
    return 1
}

# Read current user config
get_configured_lang() {
    local cfg="$HOME/.config/qes/config.json"
    if [[ -f "$cfg" ]]; then
        local l
        l=$(grep -o '"lang"[[:space:]]*:[[:space:]]*"[^"]*"' "$cfg" 2>/dev/null | cut -d'"' -f4 || true)
        if [[ -n "$l" ]]; then
            echo "$l"
            return 0
        fi
    fi
    echo "auto"
}

get_configured_layout() {
    local cfg="$HOME/.config/qes/config.json"
    if [[ -f "$cfg" ]]; then
        local l
        l=$(grep -o '"layout"[[:space:]]*:[[:space:]]*"[^"]*"' "$cfg" 2>/dev/null | cut -d'"' -f4 || true)
        if [[ -n "$l" ]]; then
            echo "$l"
            return 0
        fi
    fi
    echo "categorized"
}

# Detect effective language
get_effective_lang() {
    local mode="${1:-$(get_configured_lang)}"
    if [[ "$mode" == "en" ]]; then
        echo "en"
        return 0
    fi
    if [[ "$mode" == "uk" || "$mode" == "ua" ]]; then
        echo "uk"
        return 0
    fi

    # Auto-detection from environment
    local l="${LANGUAGE:-${LC_ALL:-${LC_MESSAGES:-${LANG:-}}}}"
    if [[ -z "$l" && -f /etc/default/locale ]]; then
        l=$(grep -E '^(LANGUAGE|LANG|LC_MESSAGES)=' /etc/default/locale | head -n1 | cut -d= -f2 | tr -d '"' || true)
    fi
    if [[ "${l,,}" =~ ^uk ]]; then
        echo "uk"
    else
        echo "en"
    fi
}

deploy_nautilus_scripts_for_dir() {
    local target_home="$1"
    local effective_lang="$2"
    local src_dir="$3"
    local layout="${4:-$(get_configured_layout)}"
    local target_base="$target_home/.local/share/nautilus/scripts"

    mkdir -p "$target_base"

    local target_folder other_folder
    if [[ "$effective_lang" == "en" ]]; then
        target_folder="$target_base/$FOLDER_EN"
        other_folder="$target_base/$FOLDER_UK"
    else
        target_folder="$target_base/$FOLDER_UK"
        other_folder="$target_base/$FOLDER_EN"
    fi

    rm -rf "$other_folder"
    rm -rf "$target_folder"
    mkdir -p "$target_folder"

    # Копіюємо глобальний .i18n.sh
    if [[ -f "$src_dir/_i18n.sh" ]]; then
        cp "$src_dir/_i18n.sh" "$target_folder/.i18n.sh"
        chmod 0755 "$target_folder/.i18n.sh"
    fi

    if [[ "$layout" == "categorized" || "$layout" == "submenus" || "$layout" == "compact" ]]; then
        # GNOME HIG Категоризовані підменю + прямий доступ до архівної мітки LTV у корені меню
        if [[ "$effective_lang" == "en" ]]; then
            for cat_name in "${ORDERED_CATEGORIES_EN[@]}"; do
                local cat_dir="$target_folder/$cat_name"
                mkdir -p "$cat_dir"
                if [[ -f "$src_dir/_i18n.sh" ]]; then
                    cp "$src_dir/_i18n.sh" "$cat_dir/.i18n.sh"
                    chmod 0755 "$cat_dir/.i18n.sh"
                fi
                IFS="|" read -ra items <<< "${CATEGORIES_EN[$cat_name]}"
                for item in "${items[@]}"; do
                    local s_file="${item%%:*}"
                    local s_disp="${item##*:}"
                    if [[ -f "$src_dir/$s_file" ]]; then
                        cp "$src_dir/$s_file" "$cat_dir/$s_disp"
                        chmod 0755 "$cat_dir/$s_disp"
                    fi
                done
            done
            if [[ -f "$src_dir/15_upgrade_ltv.sh" ]]; then
                cp "$src_dir/15_upgrade_ltv.sh" "$target_folder/🔏 Upgrade to Archival LTV (PAdES-LTA, 25 Years)"
                chmod 0755 "$target_folder/🔏 Upgrade to Archival LTV (PAdES-LTA, 25 Years)"
            fi
        else
            for cat_name in "${ORDERED_CATEGORIES_UK[@]}"; do
                local cat_dir="$target_folder/$cat_name"
                mkdir -p "$cat_dir"
                if [[ -f "$src_dir/_i18n.sh" ]]; then
                    cp "$src_dir/_i18n.sh" "$cat_dir/.i18n.sh"
                    chmod 0755 "$cat_dir/.i18n.sh"
                fi
                IFS="|" read -ra items <<< "${CATEGORIES_UK[$cat_name]}"
                for item in "${items[@]}"; do
                    local s_file="${item%%:*}"
                    local s_disp="${item##*:}"
                    if [[ -f "$src_dir/$s_file" ]]; then
                        cp "$src_dir/$s_file" "$cat_dir/$s_disp"
                        chmod 0755 "$cat_dir/$s_disp"
                    fi
                done
            done
            if [[ -f "$src_dir/15_upgrade_ltv.sh" ]]; then
                cp "$src_dir/15_upgrade_ltv.sh" "$target_folder/🔏 Додати архівну мітку LTV (PAdES-LTA, 25 років)"
                chmod 0755 "$target_folder/🔏 Додати архівну мітку LTV (PAdES-LTA, 25 років)"
            fi
        fi
    elif [[ "$layout" == "hybrid" ]]; then
        # Гібридний макет: категорії + плоскі посилання у корені
        if [[ "$effective_lang" == "en" ]]; then
            for cat_name in "${ORDERED_CATEGORIES_EN[@]}"; do
                local cat_dir="$target_folder/$cat_name"
                mkdir -p "$cat_dir"
                if [[ -f "$src_dir/_i18n.sh" ]]; then
                    cp "$src_dir/_i18n.sh" "$cat_dir/.i18n.sh"
                    chmod 0755 "$cat_dir/.i18n.sh"
                fi
                IFS="|" read -ra items <<< "${CATEGORIES_EN[$cat_name]}"
                for item in "${items[@]}"; do
                    local s_file="${item%%:*}"
                    local s_disp="${item##*:}"
                    if [[ -f "$src_dir/$s_file" ]]; then
                        cp "$src_dir/$s_file" "$cat_dir/$s_disp"
                        chmod 0755 "$cat_dir/$s_disp"
                        local flat_name="${SCRIPTS_EN[$s_file]:-$s_disp}"
                        ln -sf "$cat_name/$s_disp" "$target_folder/$flat_name" 2>/dev/null || cp "$src_dir/$s_file" "$target_folder/$flat_name"
                    fi
                done
            done
        else
            for cat_name in "${ORDERED_CATEGORIES_UK[@]}"; do
                local cat_dir="$target_folder/$cat_name"
                mkdir -p "$cat_dir"
                if [[ -f "$src_dir/_i18n.sh" ]]; then
                    cp "$src_dir/_i18n.sh" "$cat_dir/.i18n.sh"
                    chmod 0755 "$cat_dir/.i18n.sh"
                fi
                IFS="|" read -ra items <<< "${CATEGORIES_UK[$cat_name]}"
                for item in "${items[@]}"; do
                    local s_file="${item%%:*}"
                    local s_disp="${item##*:}"
                    if [[ -f "$src_dir/$s_file" ]]; then
                        cp "$src_dir/$s_file" "$cat_dir/$s_disp"
                        chmod 0755 "$cat_dir/$s_disp"
                        local flat_name="${SCRIPTS_UK[$s_file]:-$s_disp}"
                        ln -sf "$cat_name/$s_disp" "$target_folder/$flat_name" 2>/dev/null || cp "$src_dir/$s_file" "$target_folder/$flat_name"
                    fi
                done
            done
        fi
    else
        # Традиційний плоский список (без категорій)
        if [[ "$effective_lang" == "en" ]]; then
            for script_file in "${!SCRIPTS_EN[@]}"; do
                if [[ -f "$src_dir/$script_file" ]]; then
                    local display_name="${SCRIPTS_EN[$script_file]}"
                    cp "$src_dir/$script_file" "$target_folder/$display_name"
                    chmod 0755 "$target_folder/$display_name"
                fi
            done
        else
            for script_file in "${!SCRIPTS_UK[@]}"; do
                if [[ -f "$src_dir/$script_file" ]]; then
                    local display_name="${SCRIPTS_UK[$script_file]}"
                    cp "$src_dir/$script_file" "$target_folder/$display_name"
                    chmod 0755 "$target_folder/$display_name"
                fi
            done
        fi
    fi

    # Автоматичний запуск синхронізації мови при вході користувача в сесію
    if [[ -d "$target_home" ]]; then
        mkdir -p "$target_home/.config/autostart"
        cat << 'EOF' > "$target_home/.config/autostart/qes-locale-sync.desktop"
[Desktop Entry]
Type=Application
Name=QES Tools Locale Sync
Comment=Synchronize QES Tools Nautilus menu language with active desktop session
Exec=/usr/bin/qes-config --refresh
Terminal=false
Hidden=false
NoDisplay=true
X-GNOME-Autostart-enabled=true
EOF
        chmod 0644 "$target_home/.config/autostart/qes-locale-sync.desktop" 2>/dev/null || true
    fi
}

save_user_config() {
    local mode="$1"
    local layout="${2:-$(get_configured_layout)}"
    local cfg_dir="$HOME/.config/qes"
    mkdir -p "$cfg_dir"
    cat > "$cfg_dir/config.json" << EOF
{
  "lang": "$mode",
  "layout": "$layout"
}
EOF
}

show_status() {
    local cfg_mode
    cfg_mode=$(get_configured_lang)
    local cfg_layout
    cfg_layout=$(get_configured_layout)
    local eff_lang
    eff_lang=$(get_effective_lang "$cfg_mode")
    local sys_locale="${LANG:-not set}"

    local scripts_dir="$HOME/.local/share/nautilus/scripts"
    local active_folder="None"
    if [[ -d "$scripts_dir/$FOLDER_UK" ]]; then
        active_folder="$FOLDER_UK (Українська)"
    elif [[ -d "$scripts_dir/$FOLDER_EN" ]]; then
        active_folder="$FOLDER_EN (English)"
    fi

    echo -e "\n${CLR_BOLD}${CLR_CYAN}╔═══════════════════════════════════════════════════════════════════════════════════════╗${CLR_RESET}"
    echo -e "${CLR_BOLD}${CLR_CYAN}║ НАЛАШТУВАННЯ ТА ЛОКАЛІЗАЦІЯ QES TOOLS / CONFIGURATION & LOCALE${CLR_RESET}"
    echo -e "${CLR_CYAN}╟───────────────────────────────────────────────────────────────────────────────────────╢${CLR_RESET}"
    echo -e "${CLR_CYAN}║ • Режим конфігурації / Config mode:  ${CLR_BOLD}${CLR_GREEN}${cfg_mode}${CLR_RESET}"
    echo -e "${CLR_CYAN}║ • Макет меню Nautilus / Menu layout: ${CLR_BOLD}${CLR_GREEN}${cfg_layout}${CLR_RESET} ($([ "$cfg_layout" = "categorized" ] && echo "GNOME HIG Категорії" || echo "Плоский список"))"
    echo -e "${CLR_CYAN}║ • Активна мова / Effective language: ${CLR_BOLD}${CLR_YELLOW}${eff_lang}${CLR_RESET} ($([ "$eff_lang" = "uk" ] && echo "Українська 🇺🇦" || echo "English 🇬🇧"))"
    echo -e "${CLR_CYAN}║ • Локаль системи / System locale:    ${CLR_GRAY}${sys_locale}${CLR_RESET}"
    echo -e "${CLR_CYAN}║ • Меню Nautilus / Active folder:     ${CLR_BOLD}${CLR_GREEN}${active_folder}${CLR_RESET}"
    echo -e "${CLR_BOLD}${CLR_CYAN}╚═══════════════════════════════════════════════════════════════════════════════════════╝${CLR_RESET}\n"
}

show_help() {
    echo -e "
${CLR_BOLD}${CLR_CYAN}qes-config — Керування конфігурацією та мовою інтерфейсу QES Tools${CLR_RESET}

${CLR_BOLD}ВИКОРИСТАННЯ / USAGE:${CLR_RESET}
  qes-config [ОПЦІЇ / OPTIONS]

${CLR_BOLD}ОПЦІЇ / OPTIONS:${CLR_RESET}
  ${CLR_GREEN}--lang uk | ua${CLR_RESET}           Встановити українську мову інтерфейсу (меню: '${FOLDER_UK}')
  ${CLR_GREEN}--lang en${CLR_RESET}                Set English interface language (menu: '${FOLDER_EN}')
  ${CLR_GREEN}--lang auto${CLR_RESET}              Автовизначення за мовою системи (\$LANG) / Auto-detect locale
  ${CLR_GREEN}--layout categorized${CLR_RESET}     Категоризовані підменю за стандартами GNOME HIG (за замовчуванням)
  ${CLR_GREEN}--layout flat${CLR_RESET}            Традиційний плоский список дій (16 пунктів)
  ${CLR_GREEN}--status${CLR_RESET}                 Показати поточні налаштування / Show current configuration
  ${CLR_GREEN}--refresh${CLR_RESET}                Перевстановити скрипти Nautilus / Re-deploy scripts
  ${CLR_GREEN}--all-users${CLR_RESET}              Розгорнути для всіх користувачів системи (потрібні права root)
  ${CLR_GREEN}-h, --help${CLR_RESET}               Показати цю довідку / Show help

${CLR_BOLD}ПРИКЛАДИ / EXAMPLES:${CLR_RESET}
  qes-config --lang en                   # Switch to English
  qes-config --lang uk                   # Перемкнути на українську
  qes-config --layout categorized        # Використовувати категоризовані підменю GNOME HIG
  qes-config --layout flat               # Традиційний плоский список
  qes-config --status                    # Перевірити поточний стан
"
}

main() {
    local cmd="${1:---status}"
    local target_lang=""
    local target_layout=""
    local all_users=false

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --lang)
                target_lang="${2:-}"
                shift 2 || true
                ;;
            --uk|--ua)
                target_lang="uk"
                shift
                ;;
            --en)
                target_lang="en"
                shift
                ;;
            --layout)
                target_layout="${2:-}"
                shift 2 || true
                ;;
            --categorized|--submenus)
                target_layout="categorized"
                shift
                ;;
            --flat)
                target_layout="flat"
                shift
                ;;
            --status)
                show_status
                return 0
                ;;
            --refresh)
                target_lang="$(get_configured_lang)"
                target_layout="$(get_configured_layout)"
                shift
                ;;
            --all-users)
                all_users=true
                shift
                ;;
            -h|--help|help)
                show_help
                return 0
                ;;
            *)
                echo -e "${CLR_RED}Невідомий параметр: $1. Використовуйте qes-config --help.${CLR_RESET}"
                return 1
                ;;
        esac
    done

    if [[ -z "$target_lang" && -z "$target_layout" ]]; then
        show_status
        return 0
    fi

    [[ -z "$target_lang" ]] && target_lang="$(get_configured_lang)"
    [[ -z "$target_layout" ]] && target_layout="$(get_configured_layout)"

    # Validate language
    case "${target_lang,,}" in
        uk|ua)
            target_lang="uk"
            ;;
        en)
            target_lang="en"
            ;;
        auto)
            target_lang="auto"
            ;;
        *)
            echo -e "${CLR_RED}Помилка: невідома мова '${target_lang}'. Допустимі значення: uk, en, auto.${CLR_RESET}"
            return 1
            ;;
    esac

    # Validate layout
    case "${target_layout,,}" in
        categorized|cat|submenus|categories)
            target_layout="categorized"
            ;;
        flat|legacy)
            target_layout="flat"
            ;;
        *)
            echo -e "${CLR_RED}Помилка: невідомий макет '${target_layout}'. Допустимі значення: categorized, flat.${CLR_RESET}"
            return 1
            ;;
    esac

    local src_dir
    src_dir=$(find_source_scripts_dir || true)
    if [[ -z "$src_dir" ]]; then
        echo -e "${CLR_RED}Помилка: не знайдено каталог вихідних скриптів Nautilus.${CLR_RESET}"
        return 1
    fi

    if [[ "$all_users" == true ]]; then
        # System-wide installation
        echo -e "${CLR_YELLOW}Розгортання налаштувань для всіх користувачів системи (режим: ${target_lang}, макет: ${target_layout})...${CLR_RESET}"
        
        # /etc/skel
        local eff_skel
        eff_skel=$(get_effective_lang "$target_lang")
        deploy_nautilus_scripts_for_dir "/etc/skel" "$eff_skel" "$src_dir" "$target_layout"
        mkdir -p "/etc/skel/.config/qes"
        echo "{\"lang\": \"$target_lang\", \"layout\": \"$target_layout\"}" > "/etc/skel/.config/qes/config.json"

        for u_home in /home/*; do
            if [[ -d "$u_home" ]]; then
                local u
                u=$(basename "$u_home")
                if id "$u" >/dev/null 2>&1; then
                    local eff_u
                    eff_u=$(get_effective_lang "$target_lang")
                    deploy_nautilus_scripts_for_dir "$u_home" "$eff_u" "$src_dir" "$target_layout"
                    chown -R "$u:" "$u_home/.local/share/nautilus/scripts" 2>/dev/null || true
                    mkdir -p "$u_home/.config/qes"
                    echo "{\"lang\": \"$target_lang\", \"layout\": \"$target_layout\"}" > "$u_home/.config/qes/config.json"
                    chown -R "$u:" "$u_home/.config/qes" 2>/dev/null || true
                fi
            fi
        done
        echo -e "${CLR_GREEN}✅ Успішно розгорнуто для всіх користувачів.${CLR_RESET}"
        pkill -x nautilus 2>/dev/null || true
        return 0
    fi

    # Single user setup
    save_user_config "$target_lang" "$target_layout"
    local eff_lang
    eff_lang=$(get_effective_lang "$target_lang")
    deploy_nautilus_scripts_for_dir "$HOME" "$eff_lang" "$src_dir" "$target_layout"

    # Reload Nautilus
    pkill -x nautilus 2>/dev/null || true
    if command -v nautilus >/dev/null 2>&1; then
        nautilus -q 2>/dev/null || true
    fi

    if [[ "$eff_lang" == "en" ]]; then
        echo -e "\n${CLR_GREEN}✅ Language set to English (en) [Layout: ${target_layout}].${CLR_RESET}"
        echo -e "Nautilus context menu updated to: ${CLR_BOLD}${CLR_CYAN}${FOLDER_EN}${CLR_RESET}\n"
    else
        echo -e "\n${CLR_GREEN}✅ Встановлено українську мову (uk) [Макет: ${target_layout}].${CLR_RESET}"
        echo -e "Меню Nautilus оновлено на: ${CLR_BOLD}${CLR_CYAN}${FOLDER_UK}${CLR_RESET}\n"
    fi
}

main "$@"
