  ["3_sign_asice.sh"]="📦 Підписати контейнер (ASiC-E)"
  ["10_append_signature.sh"]="✍️ Додати другий підпис (Мультипідпис)"
  ["15_upgrade_ltv.sh"]="🔏 Додати архівну мітку LTV (PAdES-LTA, 25 років)"
  ["4_verify.sh"]="🔍 Перевірити підпис КЕП"
  ["13_view_cert.sh"]="📜 Переглянути сертифікат КНЕДП"
  ["8_export_cert.sh"]="📤 Експортувати відкритий сертифікат (.cer)"
  ["5_encrypt_self.sh"]="🛡️ Зашифрувати в особистий сейф (.enc)"
  ["6_encrypt_recipient.sh"]="📨 Зашифрувати для адресата (.enc)"
  ["7_decrypt.sh"]="🔓 Розшифрувати особистим КЕП"
  ["9_pdf_court.sh"]="⚖️ Оптимізувати PDF для Е-Суду"
  ["12_ocr_court.sh"]="👁️ Розпізнати текст OCR (Е-Суд)"
  ["14_ocr_english.sh"]="👁️ Розпізнати текст OCR (Англійська)"
  ["11_lock_session.sh"]="🔒 Скинути кеш пароля (Заблокувати)"
  ["0_help.sh"]="📖 Довідка та Інструкції КЕП"
)

declare -A SCRIPTS_EN=(
  ["1_sign_pades.sh"]="✍️ Sign PDF (with Stamp & QR)"
  ["1b_sign_pades_no_stamp.sh"]="✍️ Sign PDF (without Stamp & QR)"
  ["2_sign_p7s.sh"]="✍️ Sign Detached Signature (.p7s)"
  ["3_sign_asice.sh"]="📦 Sign Package Container (ASiC-E)"
  ["10_append_signature.sh"]="✍️ Add Secondary Signature (Multi-Sign)"
  ["15_upgrade_ltv.sh"]="🔏 Upgrade to Archival LTV (PAdES-LTA, 25 Years)"
  ["4_verify.sh"]="🔍 Verify QES Signature"
  ["13_view_cert.sh"]="📜 View CA Certificate Details"
  ["8_export_cert.sh"]="📤 Export Public Certificate (.cer)"
  ["5_encrypt_self.sh"]="🛡️ Encrypt to Personal Vault (.enc)"
