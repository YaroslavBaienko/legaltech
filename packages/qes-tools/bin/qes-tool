#!/usr/bin/env bash
# ==============================================================================
# qes-tool — Master CLI umbrella & documentation guide for QES Tools Suite
# 100% Offline-First | Ukrainian Qualified Electronic Signature (КЕП / ДСТУ 4145)
# ==============================================================================
set -euo pipefail

# ANSI color codes (disabled if stdout is not a TTY or NO_COLOR is set)
if [[ -t 1 && -z "${NO_COLOR:-}" ]]; then
    CLR_RESET="\033[0m"
    CLR_BOLD="\033[1m"
    CLR_GREEN="\033[32m"
    CLR_CYAN="\033[36m"
    CLR_YELLOW="\033[33m"
    CLR_RED="\033[31m"
    CLR_GRAY="\033[90m"
    CLR_BLUE="\033[34m"
else
    CLR_RESET=""
    CLR_BOLD=""
    CLR_GREEN=""
    CLR_CYAN=""
    CLR_YELLOW=""
    CLR_RED=""
    CLR_GRAY=""
    CLR_BLUE=""
fi

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PACKAGE_DIR="$(cd "${SCRIPT_DIR}/.." 2>/dev/null && pwd || true)"

REAL_SCRIPT="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || realpath "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")"
REAL_BIN_DIR="$(cd "$(dirname "${REAL_SCRIPT}")" 2>/dev/null && pwd || true)"
REAL_PKG_DIR="$(cd "${REAL_BIN_DIR}/.." 2>/dev/null && pwd || true)"

get_version() {
    local candidates=(
        "${REAL_PKG_DIR}/package.json"
        "/usr/lib/qes-tools/package.json"
        "${PACKAGE_DIR}/package.json"
    )
    for c in "${candidates[@]}"; do
        if [[ -f "$c" ]]; then
            local v
            v=$(grep -o '"version"[[:space:]]*:[[:space:]]*"[^"]*"' "$c" 2>/dev/null | head -n1 | cut -d'"' -f4 || true)
            if [[ -n "$v" ]]; then
                echo "$v"
                return 0
            fi
        fi
    done
    echo "1.0.8"
}

VERSION="$(get_version)"

get_lang() {
    # 1. Explicit override via QES_LANG
    if [[ -n "${QES_LANG:-}" ]]; then
        if [[ "$QES_LANG" == "en" ]]; then echo "en"; return 0; fi
        echo "uk"; return 0
    fi

    # 2. Config file ~/.config/qes/config.json
    local cfg="$HOME/.config/qes/config.json"
    if [[ -f "$cfg" ]]; then
        local l
        l=$(grep -o '"lang"[[:space:]]*:[[:space:]]*"[^"]*"' "$cfg" 2>/dev/null | cut -d'"' -f4 || true)
        if [[ "$l" == "en" ]]; then echo "en"; return 0; fi
        if [[ "$l" == "uk" ]]; then echo "uk"; return 0; fi
    fi

    # 3. System locale ($LC_ALL, $LC_MESSAGES, $LANG)
    local loc="${LC_ALL:-${LC_MESSAGES:-${LANG:-uk_UA.UTF-8}}}"
    if [[ "$loc" =~ ^uk || "$loc" =~ ^uk_ ]]; then
        echo "uk"
    else
        echo "en"
    fi
}

CURRENT_LANG="$(get_lang)"

show_version() {
    echo "qes-tools v${VERSION}"
}

