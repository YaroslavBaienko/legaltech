  $ qes-tool agent [status|clear]  (еквівалент qes-agent)
  $ qes-tool config [--lang...]    (еквівалент qes-config)
  $ qes-tool pdf-court [файл.pdf]  (еквівалент qes-pdf-court)
  $ qes-tool ocr [файл...]         (еквівалент qes-ocr)
${CLR_BOLD}${CLR_CYAN}================================================================================${CLR_RESET}
EOF
}

