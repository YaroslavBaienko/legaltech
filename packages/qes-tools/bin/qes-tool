show_help() {
    if [[ "$CURRENT_LANG" == "en" ]]; then
        show_help_en
    else
        show_help_uk
    fi
}

find_subcommand_binary() {
    local target="$1"
    # 1. In relative bin dir
    if [[ -x "${REAL_BIN_DIR}/$target" ]]; then
        echo "${REAL_BIN_DIR}/$target"
        return 0
    fi
    # 2. In relative bin dir as .js
    if [[ -f "${REAL_BIN_DIR}/${target}.js" ]]; then
        echo "${REAL_BIN_DIR}/${target}.js"
        return 0
    fi
    # 3. System command in PATH
    if command -v "$target" >/dev/null 2>&1; then
        command -v "$target"
        return 0
    fi
    # 4. In /usr/bin
    if [[ -x "/usr/bin/$target" ]]; then
        echo "/usr/bin/$target"
        return 0
    fi
    # 5. In /usr/lib/qes-tools/bin
    if [[ -x "/usr/lib/qes-tools/bin/$target" ]]; then
        echo "/usr/lib/qes-tools/bin/$target"
        return 0
    fi
    if [[ -f "/usr/lib/qes-tools/bin/${target}.js" ]]; then
        echo "/usr/lib/qes-tools/bin/${target}.js"
        return 0
    fi
    return 1
}

# ------------------------------------------------------------------------------
# Dispatcher logic
# ------------------------------------------------------------------------------
if [[ $# -eq 0 ]]; then
    show_help
    exit 0
fi

ACTION="$1"
shift

case "$ACTION" in
    -v|--version|version)
        show_version
        exit 0
        ;;
    -h|--help|help)
        show_help
        exit 0
        ;;
    token|tokens)
        node -e "
        const { detectHardwareTokens } = require('${REAL_PKG_DIR}/src/providers');
        const res = detectHardwareTokens();
        if (res.detected) {
            console.log('\x1b[1m\x1b[32m✔ ЗНАЙДЕНО ПІДКЛЮЧЕНИЙ АПАРАТНИЙ НОСІЙ (ЗНОК):\x1b[0m');
            res.tokens.forEach((t, i) => {
                console.log('  [' + (i + 1) + '] \x1b[1m' + t.name + '\x1b[0m');
                console.log('      Виробник:    ' + t.manufacturer);
                console.log('      Провайдер:   ' + t.provider);
                console.log('      Тип носія:   ' + t.type);
                console.log('      ID пристрою: ' + t.vendorId + ':' + t.productId);
                if (t.driverPath) {
                    const drvStatus = t.driverInstalled ? '\x1b[32m✔ встановлено\x1b[0m' : '\x1b[33m(інтегровано в пакет)\x1b[0m';
                    console.log('      Драйвер PKCS#11: ' + t.driverPath + ' ' + drvStatus);
                }
            });
            console.log('');
            if (res.pcscdRunning) {
                console.log('  🟢 Служба смарт-карт (pcscd) активна в системі.');
            } else {
                console.log('  💡 Для прямої роботи з USB-токеном через PC/SC запустіть: sudo systemctl start pcscd');
            }
        } else {
            console.log('\x1b[33mℹ Апаратних токенів (Алмаз-1К, Кристал-1К, SecureToken-337) не виявлено.\x1b[0m');
            console.log('  Переконайтеся, що USB-токен підключено до комп\'ютера.');
        }
        "
        exit 0
        ;;
    providers)
        node -e "
        const { PROVIDERS } = require('${REAL_PKG_DIR}/src/providers');
        console.log('\x1b[1m\x1b[36m🏛️ РЕЄСТР КВАЛІФІКОВАНИХ НАДАВАЧІВ ДОВІРЧИХ ПОСЛУГ УКРАЇНИ (КНЕДП):\x1b[0m\n');
        Object.values(PROVIDERS).forEach((p, i) => {
            console.log('  ' + (i + 1) + '. \x1b[1m' + p.name + '\x1b[0m');
            console.log('     ЄДРПОУ: ' + p.edrpou + ' | Домен: ' + p.domains.join(', '));
            console.log('     CMP (автопошук): ' + (p.cmp ? p.cmp[0] : '—'));
            console.log('     TSP (мітка часу): ' + (p.tsp ? p.tsp[0] : '—'));
            console.log('     OCSP (онлайн):   ' + (p.ocsp ? p.ocsp[0] : '—'));
            console.log('');
        });
        "
        exit 0
        ;;
    sign|verify|encrypt|decrypt|export-cert|cert|agent|config|pdf-court|ocr)
        TARGET_BIN="qes-${ACTION}"
        BIN_PATH="$(find_subcommand_binary "$TARGET_BIN" || true)"
        if [[ -z "$BIN_PATH" ]]; then
            echo -e "${CLR_RED}Помилка: підкоманда '$TARGET_BIN' не знайдена в системі.${CLR_RESET}" >&2
            exit 1
        fi
        if [[ "$BIN_PATH" == *.js ]]; then
            exec node "$BIN_PATH" "$@"
        else
            exec "$BIN_PATH" "$@"
        fi
        ;;
    qes-*)
        BIN_PATH="$(find_subcommand_binary "$ACTION" || true)"
        if [[ -z "$BIN_PATH" ]]; then
            echo -e "${CLR_RED}Помилка: команда '$ACTION' не знайдена в системі.${CLR_RESET}" >&2
            exit 1
        fi
        if [[ "$BIN_PATH" == *.js ]]; then
            exec node "$BIN_PATH" "$@"
        else
            exec "$BIN_PATH" "$@"
        fi
        ;;
    *)
        echo -e "${CLR_RED}Невідома команда або опція:${CLR_RESET} $ACTION" >&2
        echo -e "Запустіть ${CLR_BOLD}qes-tool --help${CLR_RESET} для перегляду повного списку команд та прикладів." >&2
        exit 1
        ;;
esac
