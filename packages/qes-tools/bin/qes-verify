def show_gui_report(results: List[Dict[str, Any]], file_path: str):
    lang = get_qes_lang()
    is_en = (lang == "en")

    if not results:
        w_title = "QES Verification" if is_en else "Перевірка КЕП"
        w_text = f"⚠️ No electronic signatures found in file <b>{esc(os.path.basename(file_path))}</b>." if is_en else f"⚠️ У файлі <b>{esc(os.path.basename(file_path))}</b> не виявлено електронного підпису."
        subprocess.run(["zenity", "--warning", f"--title={w_title}", f"--text={w_text}"])
        return

    is_valid = True
    for r in results:
        if r.get("is_valid_at_signing") is False or r.get("manifest_verified") is False:
            is_valid = False
            break

    if is_en:
        status_title = "✅ SIGNATURE VALID" if is_valid else "❌ SIGNATURE INVALID"
    else:
        status_title = "✅ КЕП ДІЙСНИЙ" if is_valid else "❌ ПІДПИС НЕВАЛІДНИЙ"
    status_color = "#1e7e34" if is_valid else "#d9534f"

    lines = []
    lines.append(f"<span size='x-large' weight='bold' color='{status_color}'>{esc(status_title)}</span>\n")
    lines.append(f"<b>{'File' if is_en else 'Файл'}:</b> {esc(os.path.basename(file_path))}")

    is_asice = False
    asice_files = []

    for r_idx, res in enumerate(results, 1):
        c_fmt = res.get('container_format', 'QES' if is_en else 'КЕП')
        if len(results) > 1:
            hdr = f"── Signature #{r_idx}: {esc(c_fmt)} ──" if is_en else f"── Підпис #{r_idx}: {esc(c_fmt)} ──"
            lines.append(f"\n<b>{hdr}</b>")
        else:
            lbl = "Format" if is_en else "Формат"
            lines.append(f"<b>{lbl}:</b> {esc(c_fmt)}")

        st = format_iso_time(res.get("signing_time"))
        lines.append(f"<b>{'Signing Time' if is_en else 'Час підписання'}:</b> {esc(st)}")

        if res.get("has_tsp"):
            tsp_str = format_iso_time(res.get("tsp_time"))
            sub = "Certified by TSP" if is_en else "Підтверджено КНЕДП"
            lines.append(f"<b>{'Timestamp (TSP)' if is_en else 'Позначка часу (TSP)'}:</b> <span color='#1e7e34'>🕒 {esc(tsp_str)} ({esc(sub)})</span>")
        else:
            lines.append(f"<b>{'Timestamp (TSP)' if is_en else 'Позначка часу (TSP)'}:</b> ⚠️ {'No standalone TSP timestamp' if is_en else 'Відсутня окрема мітка TSP'}")

        sig_lvl = res.get("signature_level") or ("CAdES-T" if res.get("has_tsp") else "CAdES-BES")
        if res.get("has_ltv"):
            ltv_desc = f"🔏 {esc(sig_lvl)} (Archival 25+ years)" if is_en else f"🔏 {esc(sig_lvl)} (Архівне зберігання 25+ років)"
            lines.append(f"<b>{'Archival LTV' if is_en else 'Архівна мітка (LTV)'}:</b> <span color='#1e7e34'>{ltv_desc}</span>")
        else:
            lines.append(f"<b>{'Archival LTV' if is_en else 'Архівна мітка (LTV)'}:</b> {esc(sig_lvl)}")

        if res.get("manifest_verified") is True:
            m_ok = "✅ All files match checksums" if is_en else "✅ Усі файли відповідають контрольним сумам"
            lines.append(f"<b>{'Archive integrity' if is_en else 'Цілісність архіву'}:</b> <span color='#1e7e34'>{m_ok}</span>")
        elif res.get("manifest_verified") is False:
            m_err = "❌ CORRUPTED (checksum mismatch)" if is_en else "❌ ПОШКОДЖЕНО (контрольні суми не збігаються)"
            lines.append(f"<b>{'Archive integrity' if is_en else 'Цілісність архіву'}:</b> <span color='#d9534f'>{m_err}</span>")

        if res.get("signed_files"):
            is_asice = True
            asice_files = res.get("signed_files")
            s_hdr = f"Signed files ({len(asice_files)}):" if is_en else f"Підписані файли ({len(asice_files)}):"
            lines.append(f"\n<b>📦 {s_hdr}</b>")
            for sf in asice_files:
                lines.append(f"  • {esc(sf)}")

        certs = res.get("signer_certs", [])
        for c_idx, c in enumerate(certs, 1):
            subj = c.get("subject", {})
            iss = c.get("issuer", {})

            full_name = subj.get("cn") or f"{subj.get('surname', '')} {subj.get('given_name', '')}".strip() or "—"
            drfo = subj.get("drfo") or subj.get("serial_number") or "—"
            ca_name = iss.get("cn") or iss.get("organization") or "—"
            if is_en:
                q_type = "🟢 Qualified Electronic Signature (QES)" if c.get("is_qes") else "🟡 Advanced Electronic Signature (AES)"
            else:
                q_type = "🟢 Кваліфікований електронний підпис (КЕП)" if c.get("is_qes") else "🟡 Удосконалений електронний підпис (УЕП)"

            if len(certs) > 1:
                sig_hdr = f"── Signer #{c_idx} ──" if is_en else f"── Підписувач #{c_idx} ──"
                lines.append(f"\n<b>{sig_hdr}</b>")
            else:
                lines.append("")

            lines.append(f"<b>{'Signer' if is_en else 'Підписувач'}:</b> {esc(full_name)}")
            lines.append(f"<b>{'Tax ID (RNOKPP)' if is_en else 'РНОКПП (ІПН)'}:</b> {esc(drfo)}")
            if subj.get("organization") and subj.get("organization") != "ФІЗИЧНА ОСОБА":
                lines.append(f"<b>{'Organization' if is_en else 'Організація'}:</b> {esc(subj.get('organization'))}")
            if subj.get("edrpou"):
                lines.append(f"<b>{'USREOU' if is_en else 'ЄДРПОУ'}:</b> {esc(subj.get('edrpou'))}")
            lines.append(f"<b>{'CA (TSP)' if is_en else 'КНЕДП (АЦСК)'}:</b> {esc(ca_name)}")
            lines.append(f"<b>{'Signature type' if is_en else 'Тип підпису'}:</b> {esc(q_type)}")

            val_from = format_iso_time(c.get("valid_from"))
            val_to = format_iso_time(c.get("valid_to"))
            lines.append(f"<b>{'Certificate validity' if is_en else 'Дія сертифіката'}:</b> {'from' if is_en else 'з'} {esc(val_from)} {'to' if is_en else 'до'} {esc(val_to)}")

    pango_text = "\n".join(lines)

    report_title = f"QES Verification Report — {os.path.basename(file_path)}" if is_en else f"Протокол перевірки КЕП — {os.path.basename(file_path)}"
    close_btn = "Close" if is_en else "Закрити"
    extract_btn = "Extract Documents" if is_en else "Видобути документи"

    while True:
        cmd = [
            "zenity", "--info",
            f"--title={report_title}",
            f"--text={pango_text}",
            f"--ok-label={close_btn}",
            "--icon-name=application-certificate",
            "--width=650",
            "--height=460",
        ]
        user_icon = os.path.expanduser("~/.local/share/icons/Papirus/48x48/mimetypes/application-certificate.svg")
        sys_icon = "/usr/share/icons/Papirus/48x48/mimetypes/application-certificate.svg"
        if os.path.isfile(user_icon):
            cmd.append(f"--window-icon={user_icon}")
        elif os.path.isfile(sys_icon):
            cmd.append(f"--window-icon={sys_icon}")
        if is_asice:
            cmd.extend([f"--extra-button={extract_btn}"])
        cmd.extend(["--extra-button=📖 Help / Довідка"])

        proc = subprocess.run(cmd, stdout=subprocess.PIPE, text=True)
        clicked = proc.stdout.strip()

        if clicked == extract_btn:
            dlg_title = "Select folder to extract files" if is_en else "Оберіть папку для видобування файлів"
            dest_dir = subprocess.run(
                ["zenity", "--file-selection", "--directory", f"--title={dlg_title}"],
                stdout=subprocess.PIPE, text=True
            ).stdout.strip()
            if dest_dir:
                extract_asice_files(file_path, dest_dir)
                notif_title = "📦 Files Extracted" if is_en else "📦 Файли видобуто"
                notif_msg = f"Documents successfully extracted to:\n{dest_dir}" if is_en else f"Документи успішно видобуто у:\n{dest_dir}"
                if shutil.which("notify-send"):
                    subprocess.run([
                        "notify-send", "-a", "QES Tools", "-i", "folder",
                        notif_title, notif_msg
                    ])
                elif shutil.which("zenity"):
                    subprocess.run(["zenity", "--notification", f"--text={notif_title}: {notif_msg}"])
                subprocess.Popen(["xdg-open", dest_dir])
            continue
        elif "Help" in clicked or "Довідка" in clicked:
            show_help_dialog()
            continue
        else:
            break


def delegate_to_qes_cert(file_path: str, args: argparse.Namespace) -> int:
    """Делегує аналіз сертифіката спеціалізованому модулю qes-cert."""
    qes_cert_bin = shutil.which("qes-cert")
    if not qes_cert_bin:
        sibling = Path(__file__).resolve().parent / "qes-cert"
        if sibling.exists():
            qes_cert_bin = str(sibling)
        else:
            local_bin = Path.home() / ".local" / "bin" / "qes-cert"
            if local_bin.exists():
                qes_cert_bin = str(local_bin)

    if not qes_cert_bin:
        sys.stderr.write("Помилка: модуль 'qes-cert' не знайдено для перегляду сертифіката.\n")
        return 1

    cmd = [qes_cert_bin]
    if args.json:
        cmd.append("--json")
    if args.gui:
        cmd.append("--gui")
    if getattr(args, "no_color", False):
        cmd.append("--no-color")
    cmd.append(file_path)

    try:
        proc = subprocess.run(cmd)
        return proc.returncode
    except Exception as e:
        sys.stderr.write(f"Помилка виклику qes-cert: {e}\n")
        return 1


def main():
    is_en = (get_qes_lang() == "en")
    ver_str = "1.0.23"
    parser = argparse.ArgumentParser(
        description=f"""================================================================================
  qes-verify — {"Ukrainian & EU QES/AES validator (.p7s, .asice, .pdf)" if is_en else "автономний валідатор КЕП/УЕП (.p7s, .asice, .pdf)"}
  {"Version" if is_en else "Версія"} {ver_str} | 100% Offline-First | {"Legal Privilege Protected" if is_en else "Захист адвокатської таємниці"}
================================================================================

{"DESCRIPTION:" if is_en else "ОПИС:"}
  {"Validates qualified and advanced electronic signatures (QES/AES)," if is_en else "Перевіряє справжність кваліфікованих та удосконалених електронних підписів (КЕП/УЕП),"}
  {"recognizes certificates of all Ukrainian accredited QTSPs (CA), verifies" if is_en else "розпізнає сертифікати всіх акредитованих центрів України (КНЕДП/АЦСК), перевіряє"}
  {"trusted TSP timestamps, extracts signed files, with zero telemetry." if is_en else "мітку точного часу TSP, витягує підписані файли та не відправляє жодних даних у мережу."}
  {"Also automatically delegates certificates (.cer, .p7b) to qes-cert inspector." if is_en else "Також автоматично перенаправляє відкриті сертифікати (.cer, .p7b) до інспектора qes-cert."}""",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""ПРИКЛАДИ КОМАНД / EXAMPLES:

  1. PDF with embedded PAdES signature (visual stamp + QR code):
     $ qes-verify statement_signed.pdf

  2. Document with multiple signatures (multi-signature):
     $ qes-verify statement_multi_signed.pdf

  3. Detached signature (.p7s):
     $ qes-verify contract.pdf.p7s

  4. Verify matching pair [document + detached signature]:
     $ qes-verify contract.pdf contract.pdf.p7s

  5. European container archive ASiC-E (.asice):
     $ qes-verify legal_bundle.asice

  6. Extract signed documents from ASiC-E container:
     $ qes-verify -x /home/attor/Documents legal_bundle.asice

  7. Inspect public certificate (.cer) or certificate chain bundle (.p7b):
     $ qes-verify cert.cer
     $ qes-verify --gui mono.p7b

  8. Machine-readable JSON output for automated scripting:
     $ qes-verify --json statement_signed.pdf

  9. Display visual inspection dialog in GNOME (Zenity):
     $ qes-verify --gui statement_signed.pdf
================================================================================"""
    )
    parser.add_argument("files", nargs="*", default=[], help="File path(s) to signature (.p7s, .asice, .pdf), certificate (.cer, .p7b) or [document signature] pair" if is_en else "Шлях до файлу(-ів) підпису (.p7s, .asice, .pdf), сертифікатів (.cer, .p7b) або пари [документ підпис]")
    parser.add_argument("-j", "--json", action="store_true", help="Output results in structured JSON format" if is_en else "Вивести результат у структурованому форматі JSON")
    parser.add_argument("-x", "--extract", nargs="?", const=".", default=None, help="Extract signed documents to target directory" if is_en else "Видобути підписаний документ у вказану папку (за замовчуванням: поточна)")
    parser.add_argument("--gui", action="store_true", help="Display visual verification report dialog (Zenity)" if is_en else "Показати результат у графічному діалоговому вікні GNOME (Zenity)")
    parser.add_argument("--no-color", action="store_true", help="Disable colored output in terminal" if is_en else "Вимкнути кольоровий вивід у терміналі")

    args = parser.parse_args()

    if not args.files:
        if args.gui:
            cmd_sel = [
                "zenity", "--file-selection",
                f"--title={'Select document or signature to verify QES' if is_en else 'Оберіть документ або підпис для перевірки КЕП'}",
                f"--file-filter={'Documents and Signatures (*.pdf *.p7s *.asice *.cer) | *.pdf *.p7s *.asice *.asics *.cer *.crt *.der *.pem *.p7b' if is_en else 'Документи та підписи (*.pdf *.p7s *.asice *.cer) | *.pdf *.p7s *.asice *.asics *.cer *.crt *.der *.pem *.p7b'}",
                f"--file-filter={'All files (*.*) | *.*' if is_en else 'Усі файли (*.*) | *.*'}",
            ]
            sel_res = subprocess.run(cmd_sel, stdout=subprocess.PIPE, text=True)
            chosen = sel_res.stdout.strip()
            if not chosen:
                sys.exit(0)
            args.files = [chosen]
        else:
            parser.print_help()
            sys.exit(1)

    use_color = not args.no_color and sys.stdout.isatty() and not args.json and not args.gui

    target_files = []
    # Identify files
    for item in args.files:
        p = Path(item)
        if not p.exists():
            sys.stderr.write(f"Error: file '{item}' not found.\n" if is_en else f"Помилка: файл '{item}' не знайдено.\n")
            sys.exit(1)
        target_files.append(str(p.resolve()))

    # If two files were given (e.g. [doc.pdf, doc.pdf.p7s]), prioritize the signature file
    sig_files = []
    for f in target_files:
        ext = Path(f).suffix.lower()
        if ext in [".p7s", ".p7b", ".asice", ".asics", ".cer", ".crt", ".der", ".pem"]:
            sig_files.append(f)
        elif ext == ".pdf":
            sig_files.append(f)

    if not sig_files:
        sig_files = target_files

    all_results: List[Dict[str, Any]] = []
    overall_ok = True

    for sf in sig_files:
        ext = Path(sf).suffix.lower()
        if ext in [".cer", ".crt", ".der", ".pem"]:
            ret = delegate_to_qes_cert(sf, args)
            if ret != 0:
                overall_ok = False
            continue

        res_list: List[Dict[str, Any]] = []

        if ext in [".asice", ".asics"]:
            res_list = inspect_asice(sf)
            if args.extract:
                extracted = extract_asice_files(sf, args.extract)
                if not args.json and not args.gui and extracted:
                    msg = f"📦 Extracted signed files to '{args.extract}': {', '.join(map(os.path.basename, extracted))}\n" if is_en else f"📦 Видобуто підписані файли до '{args.extract}': {', '.join(map(os.path.basename, extracted))}\n"
                    print(colorize(msg, CLR_GREEN, use_color))
        elif ext in [".p7s", ".p7b"]:
            res_list = inspect_p7s(sf)
        elif ext == ".pdf":
            res_list = inspect_pades_pdf(sf)
            if not res_list:
                if not args.json and not args.gui:
                    msg = f"⚠️ No embedded PAdES signature found in '{os.path.basename(sf)}'.\n" if is_en else f"⚠️ У файлі '{os.path.basename(sf)}' не знайдено вбудованого підпису PAdES.\n"
                    print(colorize(msg, CLR_YELLOW, use_color))
                continue
        else:
            # Fallback attempt p7s
            res_list = inspect_p7s(sf)

        for idx, r in enumerate(res_list, 1):
            all_results.append(r)
            if not args.json and not args.gui:
                ok = print_cli_report(r, use_color, sig_index=idx, total_sigs=len(res_list))
                if not ok:
                    overall_ok = False

    if all_results:
        if args.gui:
            show_gui_report(all_results, sig_files[0] if sig_files else target_files[0])
        elif args.json:
            print(json.dumps(all_results, indent=2, ensure_ascii=False))

    sys.exit(0 if overall_ok else 1)


if __name__ == "__main__":
    main()
