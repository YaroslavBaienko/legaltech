#!/usr/bin/env python3
"""
qes-verify — Ukrainian & EU Qualified Electronic Signature (QES / КЕП / УЕП) Validator.
Inspects and validates electronic signatures in PKCS#7 / CAdES (.p7s),
ETSI ASiC-E containers (.asice, .asics), and PAdES signed PDF files.

Zero-telemetry / 100% offline-first: preserves legal privilege and attorney-client confidentiality.
"""

import argparse
import base64
import binascii
import hashlib
import html
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import warnings
import zipfile
import zlib
import xml.etree.ElementTree as ET
from datetime import datetime, timezone
from pathlib import Path
from typing import Any, Dict, List, Optional, Tuple

warnings.filterwarnings("ignore", category=UserWarning)

try:
    from cryptography import x509
    from cryptography.hazmat.backends import default_backend
    from cryptography.hazmat.primitives import hashes
except ImportError:
    sys.stderr.write("Помилка: модуль 'cryptography' не знайдено. Встановіть python3-cryptography.\n")
    sys.exit(1)

# ANSI Color Codes
CLR_RESET = "\033[0m"
CLR_BOLD = "\033[1m"
CLR_GREEN = "\033[32m"
CLR_RED = "\033[31m"
CLR_YELLOW = "\033[33m"
CLR_BLUE = "\033[34m"
CLR_CYAN = "\033[36m"
CLR_GRAY = "\033[90m"


def esc(val: Any) -> str:
    """Safely escapes any text for Pango/XML markup in Zenity dialogs."""
    return html.escape(str(val if val is not None else ""), quote=True)


def colorize(text: str, color: str, use_color: bool = True) -> str:
    return f"{color}{text}{CLR_RESET}" if use_color else text


def get_qes_lang() -> str:
    cfg = Path.home() / ".config" / "qes" / "config.json"
    if cfg.is_file():
        try:
            with open(cfg, "r", encoding="utf-8") as f:
                data = json.load(f)
                if data.get("lang") == "en":
                    return "en"
                if data.get("lang") in ("uk", "ua"):
                    return "uk"
        except Exception:
            pass
    l = os.environ.get("LC_ALL") or os.environ.get("LC_MESSAGES") or os.environ.get("LANG") or ""
    return "uk" if l.lower().startswith("uk") else "en"


def format_iso_time(iso_str: Optional[str]) -> str:
    if not iso_str:
        return "Not specified" if get_qes_lang() == "en" else "Не вказано"
    try:
        # Normalize ISO strings
        cleaned = iso_str.replace("Z", "+00:00")
        dt = datetime.fromisoformat(cleaned)
        # Convert to local / Kyiv time indication
        return dt.strftime("%Y-%m-%d %H:%M:%S UTC")
    except Exception:
        return iso_str


def parse_x509_cert(cert_obj: x509.Certificate) -> Dict[str, Any]:
    subject: Dict[str, str] = {}
    for attr in cert_obj.subject:
        oid = attr.oid.dotted_string
        val = str(attr.value)
        if oid == "2.5.4.3":
            subject["cn"] = val
        elif oid == "2.5.4.4":
            subject["surname"] = val
        elif oid == "2.5.4.42":
            subject["given_name"] = val
        elif oid == "2.5.4.10":
            subject["organization"] = val
        elif oid == "2.5.4.11":
            subject["org_unit"] = val
        elif oid == "2.5.4.12":
            subject["title"] = val
        elif oid == "2.5.4.7":
            subject["locality"] = val
        elif oid == "2.5.4.6":
            subject["country"] = val
        elif oid == "2.5.4.5":
            subject["serial_number"] = val
        elif oid == "1.2.804.2.1.1.1.11.1.4.1.1":
            subject["drfo"] = val
        elif oid == "1.2.804.2.1.1.1.11.1.4.2.1":
            subject["edrpou"] = val
        elif oid == "1.2.804.2.1.1.1.11.1.4.1.2":
            subject["passport"] = val

    # Extract DRFO (RNOKPP, 10 digits) / EDRPOU (8 digits) from serial_number or CN if missing from specific OIDs
    sn = subject.get("serial_number", "")
    if not subject.get("drfo"):
        if "TINUA-" in sn:
            subject["drfo"] = sn.split("TINUA-")[-1].strip()
        elif re.search(r"\b\d{10}\b", sn):
            subject["drfo"] = re.search(r"\b\d{10}\b", sn).group(0)

    if not subject.get("edrpou"):
        if "NTRUA-" in sn:
            subject["edrpou"] = sn.split("NTRUA-")[-1].strip()
        else:
            m = re.search(r"(?<!TIN)UA-(\d{8})\b", sn)
            if m:
                subject["edrpou"] = m.group(1)

    issuer: Dict[str, str] = {}
    for attr in cert_obj.issuer:
        oid = attr.oid.dotted_string
        val = str(attr.value)
        if oid == "2.5.4.3":
            issuer["cn"] = val
        elif oid == "2.5.4.10":
            issuer["organization"] = val
        elif oid == "2.5.4.5":
            issuer["serial_number"] = val
        elif oid == "2.5.4.97":
            issuer["org_id"] = val

    # CA check
    is_ca = False
    try:
        bc = cert_obj.extensions.get_extension_for_oid(x509.ExtensionOID.BASIC_CONSTRAINTS)
        is_ca = bc.value.ca
    except Exception:
        pass

    # QCStatements (eIDAS / QES check: ETSI EN 319 412)
    is_qes = False
    is_sscd = False  # Secure Signature Creation Device (token / smart card)
    try:
        for ext in cert_obj.extensions:
            if ext.oid.dotted_string == "1.3.6.1.5.5.7.1.3":  # id-pe-qcStatements
                is_qes = True
                raw = ext.value.public_bytes()
                # 0.4.0.1862.1.4 is id-etsi-qcs-QcSSCD
                if b"\x04\x00\x04\x82\x01\x04" in raw or b"0.4.0.1862.1.4" in raw or b"\x04\x08\x02\x01\x04" in raw:
                    is_sscd = True
    except Exception:
        pass

    now = datetime.now(timezone.utc)
    valid_from = cert_obj.not_valid_before_utc
    valid_to = cert_obj.not_valid_after_utc
    is_currently_valid = valid_from <= now <= valid_to

    fingerprint_sha256 = binascii.hexlify(cert_obj.fingerprint(hashes.SHA256())).decode("ascii").upper()

    return {
        "subject": subject,
        "issuer": issuer,
        "is_ca": is_ca,
        "serial_hex": hex(cert_obj.serial_number)[2:].upper(),
        "valid_from": valid_from.isoformat(),
        "valid_to": valid_to.isoformat(),
        "is_currently_valid": is_currently_valid,
        "is_qes": is_qes,
        "is_sscd": is_sscd,
        "fingerprint_sha256": fingerprint_sha256,
    }


_RAW_CA_CERTS_CACHE: Optional[List[bytes]] = None


def _get_national_ca_der_slices() -> List[bytes]:
    global _RAW_CA_CERTS_CACHE
    if _RAW_CA_CERTS_CACHE is not None:
        return _RAW_CA_CERTS_CACHE
    candidates = [
        Path(__file__).resolve().parent.parent / "certs" / "ua-all-cas.p7b",
        Path("/usr/lib/qes-tools/certs/ua-all-cas.p7b"),
    ]
    raw = b""
    for c_path in candidates:
        if c_path.is_file():
            try:
                raw = c_path.read_bytes()
                break
            except Exception:
                pass
    slices: List[bytes] = []
    i = 0
    n = len(raw)
    while i < n - 6:
        if raw[i] == 0x30 and raw[i + 1] == 0x82 and raw[i + 4] == 0x30 and raw[i + 5] == 0x82:
            length = (raw[i + 2] << 8) | raw[i + 3]
            total = length + 4
            if 200 <= total <= 4096 and i + total <= n:
                slices.append(raw[i : i + total])
                i += total
                continue
        i += 1
    _RAW_CA_CERTS_CACHE = slices
    return slices


def scan_der_certs_in_bytes(buf: bytes) -> List[Dict[str, Any]]:
    found: List[Dict[str, Any]] = []
    seen_fp = set()
    i = 0
    n = len(buf)
    while i < n - 6:
        if buf[i] == 0x30 and buf[i + 1] == 0x82 and buf[i + 4] == 0x30 and buf[i + 5] == 0x82:
            length = (buf[i + 2] << 8) | raw_len_low if False else ((buf[i + 2] << 8) | buf[i + 3])
            total = length + 4
            if 200 <= total <= 4096 and i + total <= n:
                try:
                    c_obj = x509.load_der_x509_certificate(buf[i : i + total], default_backend())
                    parsed = parse_x509_cert(c_obj)
                    fp = parsed.get("fingerprint_sha256")
                    if fp and fp not in seen_fp:
                        seen_fp.add(fp)
                        found.append(parsed)
                    i += total
                    continue
                except Exception:
                    pass
        i += 1
    return found


def compute_file_digest(path: str) -> Tuple[str, int]:
    try:
        data = Path(path).read_bytes()
        return hashlib.sha256(data).hexdigest().upper(), len(data)
    except Exception:
        return "", 0


def resolve_trust_chain(
    signer_certs: List[Dict[str, Any]],
    embedded_ca_certs: List[Dict[str, Any]],
    has_ltv: bool = False,
) -> List[Dict[str, Any]]:
    chain: List[Dict[str, Any]] = []
    seen_fp = set()

    if not signer_certs:
        return chain

    primary_signer = dict(signer_certs[0])
    primary_signer["chain_role"] = "SIGNER"
    primary_signer["source"] = "embedded_ltv"
    chain.append(primary_signer)
    if primary_signer.get("fingerprint_sha256"):
        seen_fp.add(primary_signer["fingerprint_sha256"])

    cur = primary_signer
    ca_slices = _get_national_ca_der_slices()

    for _ in range(4):
        iss_cn = (cur.get("issuer") or {}).get("cn") or (cur.get("issuer") or {}).get("organization") or ""
        subj_cn = (cur.get("subject") or {}).get("cn") or (cur.get("subject") or {}).get("organization") or ""
        if not iss_cn:
            break
        if iss_cn == subj_cn and cur.get("chain_role") != "SIGNER":
            break

        # 1. Check embedded CA certs first
        matched_embedded = None
        for ec in embedded_ca_certs:
            ec_cn = (ec.get("subject") or {}).get("cn") or (ec.get("subject") or {}).get("organization") or ""
            if ec_cn == iss_cn and ec.get("fingerprint_sha256") not in seen_fp:
                matched_embedded = dict(ec)
                matched_embedded["source"] = "embedded_ltv"
                break

        if matched_embedded:
            next_c = matched_embedded
        else:
            # 2. Fast lookup in national trust list (ua-all-cas.p7b)
            needle = iss_cn.encode("utf-8")
            candidates: List[Dict[str, Any]] = []
            for s_der in ca_slices:
                if needle in s_der:
                    try:
                        c_obj = x509.load_der_x509_certificate(s_der, default_backend())
                        parsed = parse_x509_cert(c_obj)
                        p_cn = (parsed.get("subject") or {}).get("cn") or (parsed.get("subject") or {}).get("organization") or ""
                        if p_cn == iss_cn and parsed.get("fingerprint_sha256") not in seen_fp:
                            candidates.append(parsed)
                    except Exception:
                        pass
            if not candidates:
                break
            # Prefer non-self-signed intermediate first if available, and newest validity
            candidates.sort(
                key=lambda x: (
                    1 if (x.get("issuer") or {}).get("cn") != (x.get("subject") or {}).get("cn") else 0,
                    x.get("valid_to") or "",
                ),
                reverse=True,
            )
            next_c = dict(candidates[0])
            next_c["source"] = "embedded_ltv" if has_ltv else "national_trust_list"

        n_subj = (next_c.get("subject") or {}).get("cn") or ""
        n_iss = (next_c.get("issuer") or {}).get("cn") or ""
        next_c["chain_role"] = "ROOT_CA" if (n_subj and n_subj == n_iss) else "INTERMEDIATE_CA"
        if next_c.get("fingerprint_sha256"):
            seen_fp.add(next_c["fingerprint_sha256"])
        chain.append(next_c)
        cur = next_c
        if next_c["chain_role"] == "ROOT_CA":
            break

    return chain


def inspect_p7s(path: str) -> List[Dict[str, Any]]:
    """Parse PKCS#7 / CAdES (.p7s) using openssl & cryptography."""
    cmd = ["openssl", "pkcs7", "-inform", "DER", "-in", path, "-print_certs"]
    res = subprocess.run(cmd, capture_output=True, text=True)
    if res.returncode != 0:
        # Fallback to PEM
        cmd = ["openssl", "pkcs7", "-inform", "PEM", "-in", path, "-print_certs"]
        res = subprocess.run(cmd, capture_output=True, text=True)

    certs: List[Dict[str, Any]] = []
    all_parsed_certs: List[Dict[str, Any]] = []
    seen_fps = set()
    if res.returncode == 0:
        pems = [c for c in res.stdout.split("-----END CERTIFICATE-----") if "-----BEGIN CERTIFICATE-----" in c]
        for pem in pems:
            pem_str = pem.strip() + "\n-----END CERTIFICATE-----\n"
            cert = x509.load_pem_x509_certificate(pem_str.encode("utf-8"), default_backend())
            parsed = parse_x509_cert(cert)
            if parsed.get("fingerprint_sha256"):
                seen_fps.add(parsed["fingerprint_sha256"])
            all_parsed_certs.append(parsed)
            if not parsed["is_ca"]:
                certs.append(parsed)

    # Also scan raw DER bytes for any certificates inside LTV unauthenticatedAttributes (id-smime-aa-ets-certValues)
    try:
        raw_p7s = Path(path).read_bytes()
        for extra_c in scan_der_certs_in_bytes(raw_p7s):
            fp = extra_c.get("fingerprint_sha256")
            if fp and fp not in seen_fps:
                seen_fps.add(fp)
                all_parsed_certs.append(extra_c)
                if not extra_c.get("is_ca") and not certs:
                    certs.append(extra_c)
    except Exception:
        pass

    if not certs and all_parsed_certs:
        certs = all_parsed_certs

    ca_certs = [p for p in all_parsed_certs if p.get("is_ca")]

    # Inspect ASN.1 structure for signingTime, TSP tokens, and LTV attributes (CA chain + OCSP)
    cmd_asn = ["openssl", "asn1parse", "-inform", "DER", "-in", path]
    res_asn = subprocess.run(cmd_asn, capture_output=True, text=True)

    signing_time: Optional[str] = None
    has_tsp: bool = False
    tsp_time: Optional[str] = None
    has_ca_values: bool = False
    has_ocsp: bool = False

    if res_asn.returncode == 0:
        asn_out = res_asn.stdout
        if (
            "id-smime-aa-ets-certValues" in asn_out
            or "1.2.840.113549.1.9.16.2.23" in asn_out
            or "id-smime-aa-ets-certCRLTimestamp" in asn_out
            or "1.2.840.113549.1.9.16.2.21" in asn_out
        ):
            has_ca_values = True
        if (
            "id-smime-aa-ets-revocationValues" in asn_out
            or "1.2.840.113549.1.9.16.2.24" in asn_out
            or "id-pkix-ocsp-basic" in asn_out
            or "1.3.6.1.5.5.7.48.1.1" in asn_out
        ):
            has_ocsp = True

        lines = asn_out.splitlines()
        for i, line in enumerate(lines):
            # Signing time
            if "signingTime" in line:
                for j in range(i + 1, min(i + 4, len(lines))):
                    if "UTCTIME" in lines[j] or "GENERALIZEDTIME" in lines[j]:
                        m = re.search(r":(\d{6,14}Z?)", lines[j])
                        if m and not signing_time:
                            raw = m.group(1)
                            try:
                                if len(raw) >= 12:
                                    dt = datetime.strptime(raw[:12], "%y%m%d%H%M%S").replace(tzinfo=timezone.utc)
                                    signing_time = dt.isoformat()
                            except Exception:
                                signing_time = raw
            # Timestamp token (TSP)
            if "timeStampToken" in line or "TSTInfo" in line:
                has_tsp = True
                for j in range(i + 1, min(i + 15, len(lines))):
                    if "UTCTIME" in lines[j] or "GENERALIZEDTIME" in lines[j]:
                        m = re.search(r":(\d{6,14}Z?)", lines[j])
                        if m and not tsp_time:
                            raw = m.group(1)
                            try:
                                if len(raw) >= 12:
                                    dt = datetime.strptime(raw[:12], "%y%m%d%H%M%S").replace(tzinfo=timezone.utc)
                                    tsp_time = dt.isoformat()
                            except Exception:
                                tsp_time = raw

    has_ca_chain = bool(len(ca_certs) > 0 or has_ca_values)
    has_ltv = bool(has_ocsp or (has_tsp and has_ca_chain and has_ca_values))
    if has_ltv:
        signature_level = "CAdES-LTA"
    elif has_tsp:
        signature_level = "CAdES-T"
    else:
        signature_level = "CAdES-BES"

    # Check if signature was made within cert validity
    is_valid_at_signing = None
    if signing_time and certs:
        try:
            st_clean = signing_time.replace("Z", "+00:00")
            st_dt = datetime.fromisoformat(st_clean)
            c_from = datetime.fromisoformat(certs[0]["valid_from"])
            c_to = datetime.fromisoformat(certs[0]["valid_to"])
            is_valid_at_signing = c_from <= st_dt <= c_to
        except Exception:
            pass

    file_sha256, file_size = compute_file_digest(path)
    cert_chain = resolve_trust_chain(certs, ca_certs, has_ltv=has_ltv)

    return [{
        "container_format": "PKCS#7 / CAdES (.p7s)",
        "file_path": path,
        "file_sha256": file_sha256,
        "file_size": file_size,
        "signing_time": signing_time,
        "has_tsp": has_tsp,
        "tsp_time": tsp_time,
        "has_ltv": has_ltv,
        "has_ocsp": has_ocsp,
        "has_ca_chain": has_ca_chain,
        "ca_chain_count": max(len(ca_certs), max(0, len(cert_chain) - 1)),
        "has_pdf_dss": False,
        "signature_level": signature_level,
        "is_valid_at_signing": is_valid_at_signing,
        "signer_certs": certs,
        "cert_chain": cert_chain,
        "signed_files": [],
    }]


def inspect_asice(path: str) -> List[Dict[str, Any]]:
    """Parse ETSI ASiC-E container (.asice / .asics) supporting both XAdES and CAdES signatures."""
    file_sha256, file_size = compute_file_digest(path)
    with zipfile.ZipFile(path, "r") as z:
        files = [n for n in z.namelist() if not n.startswith("META-INF/") and n != "mimetype"]
        sig_files_xml = [n for n in z.namelist() if n.startswith("META-INF/signatures") and n.endswith(".xml")]
        sig_files_p7s = [n for n in z.namelist() if n.startswith("META-INF/signature") and (n.endswith(".p7s") or n.endswith(".p7b"))]
        results: List[Dict[str, Any]] = []

        # Check cryptographic file integrity via META-INF/manifest.xml
        manifest_verified = True
        manifest_checks = {}
        if "META-INF/manifest.xml" in z.namelist():
            try:
                m_data = z.read("META-INF/manifest.xml")
                root_m = ET.fromstring(m_data)
                for ref in root_m.findall(".//{http://uri.etsi.org/02918/v1.2.1#}DataObjectReference"):
                    uri = ref.attrib.get("URI")
                    dv = ref.find(".//{http://www.w3.org/2000/09/xmldsig#}DigestValue")
                    if uri and dv is not None and dv.text and uri in z.namelist():
                        expected_hash = dv.text.strip()
                        actual_hash = base64.b64encode(hashlib.sha256(z.read(uri)).digest()).decode("ascii")
                        if actual_hash == expected_hash:
                            manifest_checks[uri] = True
                        else:
                            manifest_checks[uri] = False
                            manifest_verified = False
            except Exception:
                manifest_verified = False

        # 1. CAdES signatures inside ASiC-E
        for sf in sig_files_p7s:
            p7s_bytes = z.read(sf)
            tmp_p7s = f"/tmp/asice_sig_{os.getpid()}_{os.path.basename(sf)}"
            with open(tmp_p7s, "wb") as f_tmp:
                f_tmp.write(p7s_bytes)
            try:
                sig_res = inspect_p7s(tmp_p7s)
                for item in sig_res:
                    item["container_format"] = "ETSI ASiC-E (CAdES / ДСТУ 4145)"
                    item["file_path"] = path
                    item["file_sha256"] = file_sha256
                    item["file_size"] = file_size
                    item["signed_files"] = files
                    item["manifest_verified"] = manifest_verified if manifest_checks else None
                results.extend(sig_res)
            finally:
                if os.path.exists(tmp_p7s):
                    os.remove(tmp_p7s)

        # 2. XAdES signatures inside ASiC-E
        for sf in sig_files_xml:
            xml_data = z.read(sf)
            root = ET.fromstring(xml_data)
            ns = {
                "ds": "http://www.w3.org/2000/09/xmldsig#",
                "xades": "http://uri.etsi.org/01903/v1.3.2#",
            }

            signing_time = None
            st = root.find(".//xades:SigningTime", ns)
            if st is not None:
                signing_time = st.text

            has_tsp = False
            tsp_time = None
            # Check for timestamp tokens in XAdES
            if root.findall(".//xades:AllDataObjectsTimeStamp", ns) or root.findall(".//xades:SignatureTimeStamp", ns):
                has_tsp = True

            certs: List[Dict[str, Any]] = []
            ca_certs: List[Dict[str, Any]] = []
            for xc in root.findall(".//ds:X509Certificate", ns):
                c_bytes = base64.b64decode(xc.text.strip())
                cert = x509.load_der_x509_certificate(c_bytes, default_backend())
                parsed = parse_x509_cert(cert)
                if not parsed["is_ca"]:
                    certs.append(parsed)
                else:
                    ca_certs.append(parsed)

            is_valid_at_signing = None
            if signing_time and certs:
                try:
                    st_clean = signing_time.replace("Z", "+00:00")
                    st_dt = datetime.fromisoformat(st_clean)
                    c_from = datetime.fromisoformat(certs[0]["valid_from"])
                    c_to = datetime.fromisoformat(certs[0]["valid_to"])
                    is_valid_at_signing = c_from <= st_dt <= c_to
                except Exception:
                    pass

            cert_chain = resolve_trust_chain(certs, ca_certs, has_ltv=False)

            results.append({
                "container_format": "ETSI ASiC-E (XAdES)",
                "file_path": path,
                "file_sha256": file_sha256,
                "file_size": file_size,
                "signing_time": signing_time,
                "has_tsp": has_tsp,
                "tsp_time": tsp_time,
                "has_ltv": False,
                "has_ocsp": False,
                "has_ca_chain": len(ca_certs) > 0,
                "ca_chain_count": max(len(ca_certs), max(0, len(cert_chain) - 1)),
                "has_pdf_dss": False,
                "signature_level": "XAdES-T" if has_tsp else "XAdES-BES",
                "is_valid_at_signing": is_valid_at_signing,
                "signer_certs": certs,
                "cert_chain": cert_chain,
                "signed_files": files,
                "manifest_verified": manifest_verified if manifest_checks else None,
            })
        return results


def extract_asice_files(asice_path: str, dest_dir: str) -> List[str]:
    os.makedirs(dest_dir, exist_ok=True)
    extracted: List[str] = []
    with zipfile.ZipFile(asice_path, "r") as z:
        for name in z.namelist():
            if not name.startswith("META-INF/") and name != "mimetype":
                target = os.path.join(dest_dir, os.path.basename(name))
                with open(target, "wb") as out:
                    out.write(z.read(name))
                extracted.append(target)
    return extracted


def inspect_pades_pdf(path: str) -> List[Dict[str, Any]]:
    """Extract embedded PKCS#7 signatures and PDF /DSS certificates from PDF (PAdES)."""
    with open(path, "rb") as f:
        content = f.read()

    file_sha256 = hashlib.sha256(content).hexdigest().upper()
    file_size = len(content)

    # Search for /Contents <hex> inside PDF signature dictionary
    matches = re.findall(rb"/Contents\s*<([0-9a-fA-F\s]+)>", content)
    if not matches:
        return []

    has_pdf_dss = bool(b"/DSS" in content and (b"/Certs" in content or b"/VRI" in content))
    dss_ca_certs: List[Dict[str, Any]] = []
    if has_pdf_dss:
        for m_stream in re.finditer(rb"stream\r?\n(.*?)\r?\nendstream", content, re.DOTALL):
            raw_stream = m_stream.group(1)
            try:
                dec = zlib.decompress(raw_stream)
                for dc in scan_der_certs_in_bytes(dec):
                    if dc.get("is_ca"):
                        dss_ca_certs.append(dc)
            except Exception:
                pass

    results: List[Dict[str, Any]] = []
    for idx, hex_data in enumerate(matches):
        cleaned_hex = re.sub(rb"\s+", b"", hex_data)
        try:
            der_bytes = binascii.unhexlify(cleaned_hex)
            # Write to a temporary file in memory/tmp and reuse inspect_p7s
            tmp_p7s = f"/tmp/pades_sig_{os.getpid()}_{idx}.p7s"
            with open(tmp_p7s, "wb") as tmp_f:
                tmp_f.write(der_bytes)
            try:
                sig_res = inspect_p7s(tmp_p7s)
                for item in sig_res:
                    item["container_format"] = "PAdES (PDF Embedded Signature)"
                    item["file_path"] = path
                    item["file_sha256"] = file_sha256
                    item["file_size"] = file_size
                    item["has_pdf_dss"] = has_pdf_dss
                    if has_pdf_dss or item.get("has_ltv"):
                        item["has_ltv"] = True
                        item["signature_level"] = "PAdES-LTA"
                    elif item.get("has_tsp"):
                        item["signature_level"] = "PAdES-T"
                    else:
                        item["signature_level"] = "PAdES-BES"
                    if dss_ca_certs or item.get("has_ltv"):
                        item["cert_chain"] = resolve_trust_chain(
                            item.get("signer_certs", []),
                            dss_ca_certs,
                            has_ltv=item["has_ltv"],
                        )
                        item["has_ca_chain"] = len(item["cert_chain"]) > 1
                        item["ca_chain_count"] = max(0, len(item["cert_chain"]) - 1)
                results.extend(sig_res)
            finally:
                if os.path.exists(tmp_p7s):
                    os.remove(tmp_p7s)
        except Exception:
            continue

    return results


def print_cli_report(res: Dict[str, Any], use_color: bool = True, sig_index: int = 1, total_sigs: int = 1) -> bool:
    all_ok = True
    is_en = (get_qes_lang() == "en")
    print(colorize(f"╔═══════════════════════════════════════════════════════════════════════════════════════╗", CLR_CYAN, use_color))
    if is_en:
        if total_sigs > 1:
            print(colorize(f"║ ELECTRONIC SIGNATURE ANALYSIS (QES / AES) — SIGNATURE #{sig_index} OF {total_sigs}", CLR_BOLD + CLR_CYAN, use_color))
        else:
            print(colorize(f"║ ELECTRONIC SIGNATURE ANALYSIS (QES / AES)", CLR_BOLD + CLR_CYAN, use_color))
        print(colorize(f"║ File: {os.path.basename(res['file_path'])}", CLR_CYAN, use_color))
    else:
        if total_sigs > 1:
            print(colorize(f"║ АНАЛІЗ ЕЛЕКТРОННОГО ПІДПИСУ (QES / КЕП / УЕП) — ПІДПИС #{sig_index} З {total_sigs}", CLR_BOLD + CLR_CYAN, use_color))
        else:
            print(colorize(f"║ АНАЛІЗ ЕЛЕКТРОННОГО ПІДПИСУ (QES / КЕП / УЕП)", CLR_BOLD + CLR_CYAN, use_color))
        print(colorize(f"║ Файл: {os.path.basename(res['file_path'])}", CLR_CYAN, use_color))
    print(colorize(f"╚═══════════════════════════════════════════════════════════════════════════════════════╝", CLR_CYAN, use_color))

    container_label = "Container format:" if is_en else "Формат контейнера:"
    print(f"  {colorize(container_label, CLR_BOLD, use_color)} {res['container_format']}")

    if res.get("signed_files"):
        files_str = ", ".join(res["signed_files"])
        signed_files_label = "Signed files:" if is_en else "Підписані файли:"
        count_suffix = f"{len(res['signed_files'])} file(s)" if is_en else f"{len(res['signed_files'])} файл(-ів)"
        print(f"  {colorize(signed_files_label, CLR_BOLD, use_color)}   {colorize(files_str, CLR_BLUE, use_color)} ({count_suffix})")

    if res.get("manifest_verified") is True:
        integrity_label = "Archive integrity:" if is_en else "Цілісність архіву:"
        integrity_val = "✅ All files match checksums in manifest" if is_en else "✅ Усі файли відповідають контрольним сумам у маніфесті"
        print(f"  {colorize(integrity_label, CLR_BOLD, use_color)} {colorize(integrity_val, CLR_GREEN, use_color)}")
    elif res.get("manifest_verified") is False:
        all_ok = False
        integrity_label = "Archive integrity:" if is_en else "Цілісність архіву:"
        integrity_val = "❌ CORRUPTED (files do not match checksums in manifest!)" if is_en else "❌ ПОШКОДЖЕНО (файли не відповідають контрольним сумам у маніфесті!)"
        print(f"  {colorize(integrity_label, CLR_BOLD, use_color)} {colorize(integrity_val, CLR_RED + CLR_BOLD, use_color)}")

    # Signing Time
    st = format_iso_time(res.get("signing_time"))
    signing_time_label = "Signing time:" if is_en else "Час підписання:"
    print(f"  {colorize(signing_time_label, CLR_BOLD, use_color)}     {st}")

    # TSP
    tsp_label = "Timestamp (TSP):" if is_en else "Позначка часу (TSP):"
    if res.get("has_tsp"):
        tsp_info = ("Present" if is_en else "Присутня") + (f" ({format_iso_time(res.get('tsp_time'))})" if res.get('tsp_time') else "")
        print(f"  {colorize(tsp_label, CLR_BOLD, use_color)} {colorize(f'✅ {tsp_info}', CLR_GREEN, use_color)}")
    else:
        no_tsp = "⚠️ No dedicated TSP timestamp (claimed time by client)" if is_en else "⚠️ Відсутня окрема мітка TSP (час заявлено клієнтом)"
        print(f"  {colorize(tsp_label, CLR_BOLD, use_color)} {colorize(no_tsp, CLR_YELLOW, use_color)}")

    # Archival LTV status
    ltv_label = "Archival LTV status:" if is_en else "Архівна мітка (LTV):"
    sig_lvl = res.get("signature_level") or ("CAdES-T" if res.get("has_tsp") else "CAdES-BES")
    if res.get("has_ltv"):
        dss_tag = " + PDF /DSS" if res.get("has_pdf_dss") else ""
        ocsp_tag = " + OCSP" if res.get("has_ocsp") else ""
        ltv_info = (
            f"🔏 {sig_lvl} (CA Chain{ocsp_tag}{dss_tag} — 25+ years validity)"
            if is_en
            else f"🔏 {sig_lvl} (Ланцюжок CA{ocsp_tag}{dss_tag} — чинність 25+ років)"
        )
        print(f"  {colorize(ltv_label, CLR_BOLD, use_color)} {colorize(f'✅ {ltv_info}', CLR_GREEN, use_color)}")
    else:
        no_ltv = (
            f"ℹ️ {sig_lvl} (standard signature; upgradeable via qes-sign --upgrade-ltv)"
            if is_en
            else f"ℹ️ {sig_lvl} (стандартний підпис; можна модернізувати через qes-sign --upgrade-ltv)"
        )
        print(f"  {colorize(ltv_label, CLR_BOLD, use_color)} {colorize(no_ltv, CLR_GRAY, use_color)}")

    # Validity at signing
    validity_label = "Validity at signing:" if is_en else "Чинність на момент підпису:"
    if res.get("is_valid_at_signing") is True:
        valid_val = "✅ VALID (certificate was active at signing time)" if is_en else "✅ ДІЙСНИЙ (сертифікат діяв на дату підписання)"
        print(f"  {colorize(validity_label, CLR_BOLD, use_color)} {colorize(valid_val, CLR_GREEN, use_color)}")
    elif res.get("is_valid_at_signing") is False:
        all_ok = False
        invalid_val = "❌ INVALID (signed outside certificate validity period!)" if is_en else "❌ НЕДІЙСНИЙ (підписано поза строком дії сертифіката!)"
        print(f"  {colorize(validity_label, CLR_BOLD, use_color)} {colorize(invalid_val, CLR_RED + CLR_BOLD, use_color)}")

    print()
    certs = res.get("signer_certs", [])
    if not certs:
        no_cert = "  ⚠️ Signer certificate not found or could not be decoded." if is_en else "  ⚠️ Сертифікат підписувача не знайдено або не вдалося декодувати."
        print(colorize(no_cert, CLR_YELLOW, use_color))
        return False

    for idx, c in enumerate(certs, 1):
        subj = c["subject"]
        iss = c["issuer"]
        signer_hdr = f"  ── Signer #{idx} ─────────────────────────────────────────────────────────────" if is_en else f"  ── Підписувач #{idx} ─────────────────────────────────────────────────────────────"
        print(colorize(signer_hdr, CLR_GRAY, use_color))
        
        # Identity
        not_specified = "Not specified" if is_en else "Не вказано"
        full_name = subj.get("cn") or f"{subj.get('surname', '')} {subj.get('given_name', '')}".strip() or not_specified
        name_label = "Signer full name:" if is_en else "П.І.Б. підписувача:"
        print(f"  {colorize(name_label, CLR_BOLD, use_color)}  {colorize(full_name, CLR_BOLD, use_color)}")

        drfo = subj.get("drfo") or subj.get("serial_number") or not_specified
        drfo_label = "Tax ID (RNOKPP/DRFO):" if is_en else "РНОКПП (ДРФО/ІПН):"
        print(f"  {colorize(drfo_label, CLR_BOLD, use_color)}  {drfo}")

        if subj.get("organization") and subj.get("organization") != "ФІЗИЧНА ОСОБА":
            org_label = "Organization:" if is_en else "Організація:"
            print(f"  {colorize(org_label, CLR_BOLD, use_color)}        {subj.get('organization')}")
        if subj.get("edrpou"):
            edrpou_label = "USREOU Code:" if is_en else "Код ЄДРПОУ:"
            print(f"  {colorize(edrpou_label, CLR_BOLD, use_color)}         {subj.get('edrpou')}")
        if subj.get("title"):
            title_label = "Position/Title:" if is_en else "Посада:"
            print(f"  {colorize(title_label, CLR_BOLD, use_color)}             {subj.get('title')}")

        # Issuer / CA
        ca_name = iss.get("cn") or iss.get("organization") or not_specified
        ca_label = "QTSP (Accredited CA):" if is_en else "КНЕДП (Акредитований АЦСК):"
        print(f"  {colorize(ca_label, CLR_BOLD, use_color)} {ca_name}")

        # Qualification level
        sig_type_label = "Signature type:" if is_en else "Тип підпису:"
        if c.get("is_qes"):
            if c.get("is_sscd"):
                q_text = "🟢 Qualified Electronic Signature (QES) on secure hardware token" if is_en else "🟢 Кваліфікований електронний підпис (КЕП) на захищеному носії (токені)"
            else:
                q_text = "🟢 Qualified Electronic Signature (QES)" if is_en else "🟢 Кваліфікований електронний підпис (КЕП)"
            print(f"  {colorize(sig_type_label, CLR_BOLD, use_color)}        {colorize(q_text, CLR_GREEN, use_color)}")
        else:
            uep_text = "🟡 Advanced Electronic Signature (AES)" if is_en else "🟡 Удосконалений електронний підпис (УЕП)"
            print(f"  {colorize(sig_type_label, CLR_BOLD, use_color)}        {colorize(uep_text, CLR_YELLOW, use_color)}")

        # Certificate Validity
        val_from = format_iso_time(c.get("valid_from"))
        val_to = format_iso_time(c.get("valid_to"))
        cert_validity_label = "Certificate validity:" if is_en else "Дія сертифіката:"
        from_to_text = f"from {val_from} to {val_to}" if is_en else f"з {val_from} до {val_to}"
        print(f"  {colorize(cert_validity_label, CLR_BOLD, use_color)}    {from_to_text}")

        cur_status_label = "Current status:" if is_en else "Поточний статус:"
        if c.get("is_currently_valid"):
            stat_val = "✅ Certificate is valid today" if is_en else "✅ Сертифікат чинний сьогодні"
            print(f"  {colorize(cur_status_label, CLR_BOLD, use_color)}    {colorize(stat_val, CLR_GREEN, use_color)}")
        else:
            stat_val = "⚠️ Certificate has expired (verify validity at signing time)" if is_en else "⚠️ Термін дії сертифіката вичерпано (перевіряйте чинність на дату підпису)"
            print(f"  {colorize(cur_status_label, CLR_BOLD, use_color)}    {colorize(stat_val, CLR_YELLOW, use_color)}")

        serial_label = "Serial number:" if is_en else "Серійний номер:"
        print(f"  {colorize(serial_label, CLR_BOLD, use_color)}     {c.get('serial_hex')}")

    chain = res.get("cert_chain") or []
    if len(chain) > 1:
        chain_hdr = "  ── Certificate Trust Chain (LTV / CZO) ────────────────────────────────────" if is_en else "  ── Ланцюжок сертифікатів довіри (LTV / ЦЗО) ──────────────────────────────"
        print(colorize(chain_hdr, CLR_GRAY, use_color))
        for ch_idx, ch_cert in enumerate(chain, 1):
            role = ch_cert.get("chain_role", "")
            ch_cn = (ch_cert.get("subject") or {}).get("cn") or (ch_cert.get("subject") or {}).get("organization") or "—"
            if role == "SIGNER":
                role_lbl = "👤 Signer" if is_en else "👤 Підписувач"
            elif role == "ROOT_CA":
                role_lbl = "🇺🇦 Root CA (CZO)" if is_en else "🇺🇦 Кореневий ЦЗО"
            else:
                role_lbl = "🏛️ Accredited CA (QTSP)" if is_en else "🏛️ Акредитований КНЕДП"
            indent = "  " + ("   " * (ch_idx - 1)) + ("↳ " if ch_idx > 1 else "")
            ch_sn_short = (ch_cert.get("serial_hex") or "—")[:16]
            print(f"{indent}{colorize(f'[{ch_idx}] {role_lbl}:', CLR_BOLD, use_color)} {ch_cn} {colorize(f'(SN: {ch_sn_short}...)', CLR_GRAY, use_color)}")

    print(colorize(f"─────────────────────────────────────────────────────────────────────────────────", CLR_GRAY, use_color))
    return all_ok


def get_typst_bin() -> str:
    candidates = [
        os.environ.get("TYPST_BIN") or "",
        str(Path(__file__).resolve().parent / "typst"),
        str(Path(__file__).resolve().parent.parent / "bin" / "typst"),
        "/usr/lib/qes-tools/bin/typst",
        str(Path.home() / ".local" / "bin" / "typst"),
        shutil.which("typst") or "",
    ]
    for c in candidates:
        if c and os.path.isfile(c) and os.access(c, os.X_OK):
            return c
    return "typst"


def esc_typst(val: Any) -> str:
    s = str(val if val is not None else "")
    for ch in ("\\", "#", "[", "]", "*", "_", "$", "@", "<", ">", "`", "~"):
        s = s.replace(ch, "\\" + ch)
    return s


def format_typst_hex_wrapped(val: Any, chunk_size: int = 20) -> str:
    """Splits long unbroken hexadecimal strings into explicit Typst lines so table columns never overflow."""
    raw = str(val if val is not None else "—").strip()
    if not raw or raw == "—" or len(raw) <= chunk_size:
        return esc_typst(raw or "—")
    chunks = [esc_typst(raw[i : i + chunk_size]) for i in range(0, len(raw), chunk_size)]
    return " \\\n".join(chunks)


def ask_protocol_lang_gui(default_lang: Optional[str] = None) -> Optional[str]:
    """Displays a Zenity radiolist dialog to choose UA or EN language for PDF protocol generation."""
    cur_lang = (default_lang or get_qes_lang() or "uk").lower()
    is_en = (cur_lang == "en")

    title = "PDF Protocol Language — QES Tools" if is_en else "Мова PDF-протоколу — QES Tools"
    if is_en:
        text_pango = (
            "<span size='larger' weight='bold' color='#1a5fb4'>📄 Generate Official QES Verification PDF Protocol</span>\n\n"
            "Select the language for the generated PDF protocol (with full QTSP ➔ Root CA CZO trust chain):\n"
            "<span size='small' color='#666666'>Оберіть мову формування офіційного PDF-протоколу перевірки КЕП та ланцюжка сертифікатів:</span>"
        )
        col_pick = "Select"
        col_lang = "Protocol Language / Мова протоколу"
        ok_lbl = "📄 Generate PDF"
        cancel_lbl = "Cancel"
    else:
        text_pango = (
            "<span size='larger' weight='bold' color='#1a5fb4'>📄 Формування офіційного PDF-протоколу перевірки КЕП</span>\n\n"
            "Оберіть мову документа (протокол із повним ланцюжком сертифікатів КНЕДП ➔ ЦЗО):\n"
            "<span size='small' color='#666666'>Select the language for the official QES &amp; LTV Trust Chain Verification Protocol:</span>"
        )
        col_pick = "Вибір"
        col_lang = "Мова протоколу / Protocol Language"
        ok_lbl = "📄 Сформувати PDF"
        cancel_lbl = "Скасувати"

    uk_default = "FALSE" if is_en else "TRUE"
    en_default = "TRUE" if is_en else "FALSE"

    cmd = [
        "zenity",
        "--list",
        "--radiolist",
        f"--title={title}",
        f"--text={text_pango}",
        f"--column={col_pick}",
        "--column=Code",
        f"--column={col_lang}",
        uk_default,
        "uk",
        "🇺🇦 Українська (UA) — Протокол перевірки КЕП (ДСТУ 4145-2002 / Закон України)",
        en_default,
        "en",
        "🇬🇧 English (EN) — QES & LTV Verification Protocol (eIDAS / International)",
        "--hide-column=2",
        "--print-column=2",
        f"--ok-label={ok_lbl}",
        f"--cancel-label={cancel_lbl}",
        "--icon-name=application-pdf",
        "--width=680",
        "--height=310",
    ]
    user_icon = os.path.expanduser("~/.local/share/icons/Papirus/48x48/mimetypes/application-certificate.svg")
    sys_icon = "/usr/share/icons/Papirus/48x48/mimetypes/application-certificate.svg"
    if os.path.isfile(user_icon):
        cmd.append(f"--window-icon={user_icon}")
    elif os.path.isfile(sys_icon):
        cmd.append(f"--window-icon={sys_icon}")

    proc = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True)
    if proc.returncode != 0:
        return None
    choice = proc.stdout.strip().lower()
    if choice in ("uk", "ua"):
        return "uk"
    if choice == "en":
        return "en"
    return None


def generate_pdf_protocol(
    results: List[Dict[str, Any]],
    file_path: str,
    output_pdf_path: Optional[str] = None,
    protocol_lang: Optional[str] = None,
) -> str:
    """Generates an official vector PDF Verification & Certificate Chain Protocol using Typst."""
    eff_lang = (protocol_lang or get_qes_lang() or "uk").lower()
    is_en = (eff_lang == "en")
    src_path = Path(file_path).resolve()
    if not output_pdf_path:
        out_path = src_path.parent / f"{src_path.stem}_protocol.pdf"
    else:
        out_path = Path(output_pdf_path).resolve()
        if out_path.is_dir():
            out_path = out_path / f"{src_path.stem}_protocol.pdf"

    is_valid = bool(results)
    for r in results:
        if r.get("is_valid_at_signing") is False or r.get("manifest_verified") is False:
            is_valid = False
            break

    now_utc = datetime.now(timezone.utc).strftime("%Y-%m-%d %H:%M:%S UTC")
    first_res = results[0] if results else {}
    file_sha256 = first_res.get("file_sha256") or compute_file_digest(str(src_path))[0] or "—"
    file_size = first_res.get("file_size") or compute_file_digest(str(src_path))[1]
    c_format = first_res.get("container_format") or ("Unknown" if is_en else "Невідомо")
    sig_lvl = first_res.get("signature_level") or "CAdES"

    title_main = (
        "ELECTRONIC SIGNATURE & LTV TRUST CHAIN VERIFICATION PROTOCOL"
        if is_en
        else "ПРОТОКОЛ СТВОРЕННЯ ТА ПЕРЕВІРКИ КВАЛІФІКОВАНОГО ЕЛЕКТРОННОГО ПІДПИСУ"
    )
    subtitle_main = (
        "Compliant with the Law of Ukraine on Electronic Trust Services & Regulation (EU) No 910/2014 (eIDAS)"
        if is_en
        else "Сформовано відповідно до Закону України «Про електронну ідентифікацію та електронні довірчі послуги» і Регламенту eIDAS"
    )

    if is_valid:
        verdict_bg = "#ecfdf5"
        verdict_border = "#16a34a"
        verdict_fg = "#15803d"
        verdict_text = (
            "SIGNATURE VALID • CRYPTOGRAPHIC INTEGRITY & CA TRUST CHAIN VERIFIED"
            if is_en
            else "ПІДПИС ДІЙСНИЙ • ЦІЛІСНІСТЬ ДОКУМЕНТА ТА ЛАНЦЮЖОК ДОВІРИ КНЕДП/ЦЗО ПІДТВЕРДЖЕНО"
        )
    else:
        verdict_bg = "#fef2f2"
        verdict_border = "#dc2626"
        verdict_fg = "#b91c1c"
        verdict_text = (
            "SIGNATURE INVALID OR VERIFICATION FAILED"
            if is_en
            else "ПІДПИС НЕДІЙСНИЙ АБО ПЕРЕВІРКУ НЕ ПРОЙДЕНО"
        )

    sec1_title = "1. Verified Electronic Document & Container Metadata" if is_en else "1. Відомості про перевірений електронний документ та контейнер"
    sec2_title = "2. Electronic Signature(s), Timestamp (TSP) & Archival LTV Status" if is_en else "2. Відомості про електронний підпис, позначку часу (TSP) та архівну мітку LTV"
    sec3_title = "3. Cryptographic Certificate Trust Chain (Signer -> QTSP -> Root CA CZO)" if is_en else "3. Повний ланцюжок сертифікатів довіри (Підписувач -> КНЕДП -> ЦЗО)"

    ltv_summary = (
        f"{sig_lvl} (Archival LTV 25+ years: CA Chain + OCSP/DSS embedded)"
        if first_res.get("has_ltv") and is_en
        else (
            f"{sig_lvl} (Архівне зберігання 25+ років: ланцюжок CA + OCSP/DSS вшито)"
            if first_res.get("has_ltv")
            else f"{sig_lvl}"
        )
    )
    typ_lang = "en" if is_en else "uk"
    file_size_str = f"{file_size:,} bytes" if is_en else f"{file_size:,} байтів"

    typ_blocks: List[str] = []
    typ_blocks.append(f"""
#set page(
  paper: "a4",
  margin: (x: 1.5cm, top: 1.4cm, bottom: 1.6cm),
  footer: context [
    #line(length: 100%, stroke: 0.5pt + rgb("#cbd5e1"))
    #v(3pt)
    #grid(
      columns: (1fr, auto),
      text(size: 7.5pt, fill: rgb("#64748b"))[
        {"Generated offline by QES Tools v1.0.25 • DSTU 4145-2002 / ETSI EN 319 142 (PAdES-LTA / CAdES-LTA)" if is_en else "Сформовано автономно комплексом QES Tools v1.0.25 • ДСТУ 4145-2002 / ETSI EN 319 142 (PAdES-LTA / CAdES-LTA)"}
      ],
      text(size: 7.5pt, weight: "bold", fill: rgb("#475569"))[
        {"Page " if is_en else "Стор. "} #counter(page).display("1 / 1", both: true)
      ]
    )
  ]
)
#set text(font: ("Liberation Sans", "DejaVu Sans"), lang: "{typ_lang}", size: 9pt, fill: rgb("#0f172a"))

#rect(
  width: 100%,
  fill: rgb("#0a3d62"),
  radius: 5pt,
  inset: (x: 14pt, y: 11pt),
)[
  #text(weight: "bold", size: 11.5pt, fill: white)[{esc_typst(title_main)}]
  #v(3pt)
  #text(size: 8pt, fill: rgb("#e2e8f0"))[{esc_typst(subtitle_main)}]
]

#v(6pt)

#rect(
  width: 100%,
  fill: rgb("{verdict_bg}"),
  stroke: 1.2pt + rgb("{verdict_border}"),
  radius: 4pt,
  inset: (x: 12pt, y: 8pt),
)[
  #text(weight: "bold", size: 10pt, fill: rgb("{verdict_fg}"))[{esc_typst(verdict_text)}]
]

#v(8pt)
#text(weight: "bold", size: 10.5pt, fill: rgb("#0a3d62"))[{esc_typst(sec1_title)}]
#v(3pt)
#table(
  columns: (4.8cm, 1fr),
  inset: (x: 8pt, y: 5.5pt),
  stroke: 0.5pt + rgb("#cbd5e1"),
  fill: (x, y) => if x == 0 {{ rgb("#f8fafc") }} else {{ white }},
  [*{"File Name" if is_en else "Назва файлу"}*], [{esc_typst(src_path.name)}],
  [*{"Container Format" if is_en else "Формат контейнера"}*], [{esc_typst(c_format)}],
  [*{"Archival LTV Profile" if is_en else "Профіль архівного LTV"}*], [{esc_typst(ltv_summary)}],
  [*{"File Size" if is_en else "Розмір файлу"}*], [{esc_typst(file_size_str)}],
  [*{"SHA-256 File Digest" if is_en else "Геш-сума файла (SHA-256)"}*], [#text(font: "Liberation Mono", size: 7.8pt)[{esc_typst(file_sha256)}]],
  [*{"Total Signatures" if is_en else "Кількість підписів"}*], [{esc_typst(str(len(results)))}],
  [*{"Protocol Generated At" if is_en else "Час формування протоколу"}*], [{esc_typst(now_utc)}],
)
""")

    if first_res.get("signed_files"):
        sf_list = ", ".join(first_res["signed_files"])
        m_status = (
            "Verified (all files match META-INF/manifest.xml SHA-256 digests)"
            if first_res.get("manifest_verified") is True and is_en
            else (
                "Підтверджено (усі файли відповідають гешам META-INF/manifest.xml)"
                if first_res.get("manifest_verified") is True
                else "—"
            )
        )
        typ_blocks.append(f"""
#v(4pt)
#table(
  columns: (4.8cm, 1fr),
  inset: (x: 8pt, y: 5pt),
  stroke: 0.5pt + rgb("#cbd5e1"),
  fill: (x, y) => if x == 0 {{ rgb("#f8fafc") }} else {{ white }},
  [*{"Signed Files in ASiC-E" if is_en else "Підписані файли в ASiC-E"}*], [{esc_typst(sf_list)}],
  [*{"Manifest Integrity" if is_en else "Цілісність маніфесту"}*], [{esc_typst(m_status)}],
)
""")

    typ_blocks.append(f"""
#v(8pt)
#text(weight: "bold", size: 10.5pt, fill: rgb("#0a3d62"))[{esc_typst(sec2_title)}]
#v(3pt)
""")

    for r_idx, res in enumerate(results, 1):
        st_str = format_iso_time(res.get("signing_time"))
        tsp_str = (
            f"Verified TSP ({format_iso_time(res.get('tsp_time'))})"
            if res.get("has_tsp") and is_en
            else (
                f"Підтверджено TSP КНЕДП ({format_iso_time(res.get('tsp_time'))})"
                if res.get("has_tsp")
                else ("No standalone TSP token" if is_en else "Окрема мітка TSP відсутня")
            )
        )
        r_lvl = res.get("signature_level") or "CAdES"
        r_ltv = (
            f"{r_lvl} (CA Chain: {'Yes' if res.get('has_ca_chain') else 'No'}, OCSP: {'Yes' if res.get('has_ocsp') else 'No'}, PDF DSS: {'Yes' if res.get('has_pdf_dss') else 'No'})"
            if is_en
            else f"{r_lvl} (Ланцюжок ЦСК: {'Так' if res.get('has_ca_chain') else 'Ні'}, OCSP: {'Так' if res.get('has_ocsp') else 'Ні'}, PDF DSS: {'Так' if res.get('has_pdf_dss') else 'Ні'})"
        )

        certs = res.get("signer_certs") or [{}]
        for c_idx, c in enumerate(certs, 1):
            subj = c.get("subject") or {}
            iss = c.get("issuer") or {}
            full_name = subj.get("cn") or f"{subj.get('surname', '')} {subj.get('given_name', '')}".strip() or "—"
            drfo = subj.get("drfo") or subj.get("serial_number") or "—"
            org = subj.get("organization") or "—"
            edrpou = subj.get("edrpou") or "—"
            org_edrpou_str = f"{org} (USREOU: {edrpou})" if (edrpou != "—" and is_en) else (f"{org} (ЄДРПОУ: {edrpou})" if edrpou != "—" else org)
            title = subj.get("title") or "—"
            ca_name = iss.get("cn") or iss.get("organization") or "—"
            q_label = (
                "Qualified Electronic Signature (QES / DSTU 4145-2002)"
                if c.get("is_qes") and is_en
                else (
                    "Кваліфікований електронний підпис (КЕП / ДСТУ 4145-2002)"
                    if c.get("is_qes")
                    else (
                        "Advanced Electronic Signature (AES / DSTU 4145-2002)"
                        if is_en
                        else "Удосконалений електронний підпис (УЕП / ДСТУ 4145-2002)"
                    )
                )
            )
            val_period = f"{format_iso_time(c.get('valid_from'))} — {format_iso_time(c.get('valid_to'))}"
            serial_hex = c.get("serial_hex") or "—"
            fp_hex = c.get("fingerprint_sha256") or "—"

            sig_header = (
                f"Signature #{r_idx}" if is_en else f"Підпис #{r_idx}"
            ) + (f" (Signer #{c_idx})" if len(certs) > 1 and is_en else (f" (Підписувач #{c_idx})" if len(certs) > 1 else ""))

            typ_blocks.append(f"""
#rect(
  width: 100%,
  fill: rgb("#f1f5f9"),
  stroke: 0.5pt + rgb("#94a3b8"),
  inset: (x: 8pt, y: 4pt),
)[
  #text(weight: "bold", size: 9pt, fill: rgb("#1e3a8a"))[{esc_typst(sig_header)} — {esc_typst(full_name)}]
]
#v(-4pt)
#table(
  columns: (4.8cm, 1fr),
  inset: (x: 8pt, y: 5pt),
  stroke: 0.5pt + rgb("#cbd5e1"),
  fill: (x, y) => if x == 0 {{ rgb("#f8fafc") }} else {{ white }},
  [*{"Signer Full Name" if is_en else "П.І.Б. підписувача"}*], [*{esc_typst(full_name)}*],
  [*{"Tax ID (RNOKPP / DRFO)" if is_en else "РНОКПП (ДРФО / ІПН)"}*], [{esc_typst(drfo)}],
  [*{"Organization & USREOU" if is_en else "Організація та ЄДРПОУ"}*], [{esc_typst(org_edrpou_str)}],
  [*{"Position / Title" if is_en else "Посада"}*], [{esc_typst(title)}],
  [*{"Signature Type" if is_en else "Вид підпису"}*], [{esc_typst(q_label)}],
  [*{"Accredited CA (QTSP)" if is_en else "КНЕДП (АЦСК видавця)"}*], [{esc_typst(ca_name)}],
  [*{"Signing Time (UTC)" if is_en else "Час підписання (UTC)"}*], [{esc_typst(st_str)}],
  [*{"Qualified Timestamp (TSP)" if is_en else "Позначка точного часу (TSP)"}*], [{esc_typst(tsp_str)}],
  [*{"LTV Archival Evidence" if is_en else "Архівні докази LTV"}*], [{esc_typst(r_ltv)}],
  [*{"Certificate Validity" if is_en else "Строк дії сертифіката"}*], [{esc_typst(val_period)}],
  [*{"Certificate Serial №" if is_en else "Серійний № сертифіката"}*], [#text(font: "Liberation Mono", size: 7.8pt)[{esc_typst(serial_hex)}]],
  [*{"Certificate SHA-256" if is_en else "SHA-256 сертифіката"}*], [#text(font: "Liberation Mono", size: 7.5pt)[{esc_typst(fp_hex)}]],
)
#v(4pt)
""")

    # Section 3: Full Certificate Trust Chain
    typ_blocks.append(f"""
#v(6pt)
#text(weight: "bold", size: 10.5pt, fill: rgb("#0a3d62"))[{esc_typst(sec3_title)}]
#v(3pt)
""")

    chain_rows: List[str] = []
    for r_idx, res in enumerate(results, 1):
        chain = res.get("cert_chain") or []
        for ch_idx, ch_cert in enumerate(chain, 1):
            role = ch_cert.get("chain_role", "")
            if role == "SIGNER":
                role_txt = f"[{ch_idx}] Signer Certificate" if is_en else f"[{ch_idx}] Особистий сертифікат"
            elif role == "ROOT_CA":
                role_txt = f"[{ch_idx}] Root CA (CZO)" if is_en else f"[{ch_idx}] Кореневий ЦЗО"
            else:
                role_txt = f"[{ch_idx}] Accredited QTSP (CA)" if is_en else f"[{ch_idx}] Акредитований КНЕДП"

            ch_subj = (ch_cert.get("subject") or {}).get("cn") or (ch_cert.get("subject") or {}).get("organization") or "—"
            ch_iss = (ch_cert.get("issuer") or {}).get("cn") or (ch_cert.get("issuer") or {}).get("organization") or "—"
            ch_sn_wrapped = format_typst_hex_wrapped(ch_cert.get("serial_hex") or "—", 20)
            ch_from = (ch_cert.get("valid_from") or "")[:10]
            ch_to = (ch_cert.get("valid_to") or "")[:10]
            iss_label = "Issuer" if is_en else "Видавець"
            ch_src = (
                ("Embedded in LTV (PDF DSS / CMS)" if is_en else "Вшито в LTV (PDF DSS / CMS)")
                if ch_cert.get("source") == "embedded_ltv"
                else ("National Trust List (CZO)" if is_en else "Національний реєстр ЦЗО")
            )
            val_cell = f"{esc_typst(ch_from)} — \\\n{esc_typst(ch_to)}" if (ch_from or ch_to) else "—"
            chain_rows.append(
                f"  [{esc_typst(role_txt)}], "
                f"[*{esc_typst(ch_subj)}* \\\n#text(size: 7.5pt, fill: rgb(\"#475569\"))[{iss_label}: {esc_typst(ch_iss)}]], "
                f"[#text(font: \"Liberation Mono\", size: 7pt)[{ch_sn_wrapped}]], "
                f"[{val_cell}], "
                f"[{esc_typst(ch_src)}],"
            )

    if chain_rows:
        rows_joined = "\n".join(chain_rows)
        typ_blocks.append(f"""
#table(
  columns: (3.4cm, 1fr, 3.6cm, 2.5cm, 3.3cm),
  inset: (x: 6pt, y: 5.5pt),
  stroke: 0.5pt + rgb("#cbd5e1"),
  fill: (x, y) => if y == 0 {{ rgb("#0a3d62") }} else if calc.odd(y) {{ rgb("#f8fafc") }} else {{ white }},
  text(weight: "bold", fill: white, size: 8pt)[{"Chain Level" if is_en else "Рівень у ланцюжку"}],
  text(weight: "bold", fill: white, size: 8pt)[{"Subject & Issuer (CN)" if is_en else "Суб'єкт та Видавець (CN)"}],
  text(weight: "bold", fill: white, size: 8pt)[{"Serial Number" if is_en else "Серійний номер"}],
  text(weight: "bold", fill: white, size: 8pt)[{"Validity" if is_en else "Строк дії"}],
  text(weight: "bold", fill: white, size: 8pt)[{"Verification Source" if is_en else "Джерело перевірки"}],
{rows_joined}
)
""")

    typst_source = "\n".join(typ_blocks)
    with tempfile.TemporaryDirectory(prefix="qes-protocol-") as tmp_dir:
        typ_file = Path(tmp_dir) / "protocol.typ"
        typ_file.write_text(typst_source, encoding="utf-8")
        typst_bin = get_typst_bin()
        proc = subprocess.run(
            [typst_bin, "compile", str(typ_file), str(out_path)],
            capture_output=True,
            text=True,
        )
        if proc.returncode != 0:
            raise RuntimeError(f"Typst compilation failed: {proc.stderr.strip()}")

    return str(out_path)


def show_help_dialog():
    """Відображає довідкове вікно з повним керівництвом користувача."""
    lang = get_qes_lang()
    if lang == "en":
        help_pango = (
            "<span size='x-large' weight='bold' color='#1a5fb4'>📖 Help &amp; Instructions: QES / AES Verification</span>\n"
            "<span size='small' color='#666666'>Offline-first signature validator for DSTU 4145, CAdES, PAdES, ASiC-E</span>\n\n"
            "<b>1. SUPPORTED FORMATS:</b>\n"
            "• <b>PAdES (.pdf):</b> embedded signatures in court rulings, contracts, and applications.\n"
            "• <b>ASiC-E (.asice):</b> European container archives bundling signed document packages.\n"
            "• <b>CAdES / PKCS#7 (.p7s):</b> detached signatures (Diia, M.E.Doc, Vchasno).\n"
            "• <b>Certificates (.cer, .crt, .p7b):</b> automatically inspected via <tt>qes-cert</tt>.\n\n"
            "<b>2. VERIFICATION STATUSES:</b>\n"
            "• <span color='#1e7e34'><b>✅ SIGNATURE VALID:</b></span> mathematically valid, integrity confirmed.\n"
            "• <span color='#d9534f'><b>❌ INVALID:</b></span> document altered after signing or corrupted.\n"
            "• <b>🕒 TSP Stamp:</b> cryptographic timestamp from accredited time-stamping authority.\n"
            "• <b>🔏 Archival LTV (PAdES-LTA / CAdES-X-Long):</b> embedded CA chain, OCSP &amp; PDF /DSS for 25+ years validity.\n"
            "• <b>📄 PDF Verification Protocol:</b> generates a standalone printable PDF report with full CA trust chain.\n\n"
            "<b>3. CLI COMMANDS:</b>\n"
            "• <tt>qes-verify document_signed.pdf</tt> — verify PDF with stamp\n"
            "• <tt>qes-verify --protocol document_signed.pdf</tt> — generate PDF Verification Protocol\n"
            "• <tt>qes-verify doc.pdf doc.pdf.p7s</tt> — verify matching detached signature\n"
            "• <tt>qes-verify package.asice</tt> — verify ASiC-E archive integrity\n"
            "• <tt>qes-verify -x /folder package.asice</tt> — extract original documents\n"
            "• <tt>qes-verify cert.cer</tt> — inspect signer certificate details\n"
            "• <tt>qes-verify --json file.pdf</tt> — machine-readable JSON output\n"
        )
        title = "Help — qes-verify"
        btn = "Understood"
    else:
        help_pango = (
            "<span size='x-large' weight='bold' color='#1a5fb4'>📖 Довідка та Інструкції: Перевірка КЕП / УЕП</span>\n"
            "<span size='small' color='#666666'>Автономний аналізатор підписів ДСТУ 4145, CAdES, PAdES, ASiC-E</span>\n\n"
            "<b>1. ПІДТРИМУВАНІ ФОРМАТИ:</b>\n"
            "• <b>PAdES (.pdf):</b> вбудовані підписи в судових рішеннях, договорах, заявах.\n"
            "• <b>ASiC-E (.asice):</b> європейські контейнери архівів із пакетами підписаних файлів.\n"
            "• <b>CAdES / PKCS#7 (.p7s):</b> класичні відокремлені підписи (Дія, M.E.Doc, Вчасно).\n"
            "• <b>Сертифікати (.cer, .crt, .p7b):</b> автоматично відкриваються в інспекторі <tt>qes-cert</tt>.\n\n"
            "<b>2. СТАТУСИ ПЕРЕВІРКИ:</b>\n"
            "• <span color='#1e7e34'><b>✅ КЕП ДІЙСНИЙ:</b></span> підпис математично валідний, цілісність підтверджена.\n"
            "• <span color='#d9534f'><b>❌ НЕВАЛІДНИЙ:</b></span> документ змінено після підписання або пошкоджено.\n"
            "• <b>🕒 Мітка TSP:</b> підтвердження точного астрономічного часу від акредитованого сервера.\n"
            "• <b>🔏 Архівна мітка LTV (PAdES-LTA / CAdES-X-Long):</b> вбудований ланцюжок ЦСК, OCSP та PDF /DSS для чинності 25+ років.\n"
            "• <b>📄 PDF-протокол перевірки КЕП:</b> формує окремий друкований PDF-протокол із повним ланцюжком сертифікатів довіри.\n\n"
            "<b>3. КОМАНДИ ТЕРМІНАЛА:</b>\n"
            "• <tt>qes-verify document_signed.pdf</tt> — перевірка PDF зі штампом\n"
            "• <tt>qes-verify --protocol document_signed.pdf</tt> — сформувати PDF-протокол перевірки КЕП\n"
            "• <tt>qes-verify doc.pdf doc.pdf.p7s</tt> — перевірка відповідності оригіналу та підпису\n"
            "• <tt>qes-verify package.asice</tt> — перевірка цілісності архіву ASiC-E\n"
            "• <tt>qes-verify -x /папка package.asice</tt> — видобування оригінальних документів\n"
            "• <tt>qes-verify cert.cer</tt> — перегляд реквізитів сертифіката підписувача\n"
            "• <tt>qes-verify --json file.pdf</tt> — машинний вивід для скриптів\n"
        )
        title = "Довідка — qes-verify"
        btn = "Зрозуміло"

    subprocess.run([
        "zenity", "--info",
        f"--title={title}",
        f"--text={help_pango}",
        f"--ok-label={btn}",
        "--width=620"
    ])


def show_gui_report(results: List[Dict[str, Any]], file_path: str):
    lang = get_qes_lang()
    is_en = (lang == "en")

    if not results:
        w_title = "QES Verification" if is_en else "Перевірка КЕП"
        w_text = f"⚠️ No electronic signatures found in file <b>{esc(os.path.basename(file_path))}</b>." if is_en else f"⚠️ У файлі <b>{esc(os.path.basename(file_path))}</b> не виявлено електронного підпису."
        subprocess.run(["zenity", "--warning", f"--title={w_title}", f"--text={w_text}"])
        return

    is_valid = True
    for r in results:
        if r.get("is_valid_at_signing") is False or r.get("manifest_verified") is False:
            is_valid = False
            break

    if is_en:
        status_title = "✅ SIGNATURE VALID" if is_valid else "❌ SIGNATURE INVALID"
    else:
        status_title = "✅ КЕП ДІЙСНИЙ" if is_valid else "❌ ПІДПИС НЕВАЛІДНИЙ"
    status_color = "#1e7e34" if is_valid else "#d9534f"

    lines = []
    lines.append(f"<span size='x-large' weight='bold' color='{status_color}'>{esc(status_title)}</span>\n")
    lines.append(f"<b>{'File' if is_en else 'Файл'}:</b> {esc(os.path.basename(file_path))}")

    is_asice = False
    asice_files = []

    for r_idx, res in enumerate(results, 1):
        c_fmt = res.get('container_format', 'QES' if is_en else 'КЕП')
        if len(results) > 1:
            hdr = f"── Signature #{r_idx}: {esc(c_fmt)} ──" if is_en else f"── Підпис #{r_idx}: {esc(c_fmt)} ──"
            lines.append(f"\n<b>{hdr}</b>")
        else:
            lbl = "Format" if is_en else "Формат"
            lines.append(f"<b>{lbl}:</b> {esc(c_fmt)}")

        st = format_iso_time(res.get("signing_time"))
        lines.append(f"<b>{'Signing Time' if is_en else 'Час підписання'}:</b> {esc(st)}")

        if res.get("has_tsp"):
            tsp_str = format_iso_time(res.get("tsp_time"))
            sub = "Certified by TSP" if is_en else "Підтверджено КНЕДП"
            lines.append(f"<b>{'Timestamp (TSP)' if is_en else 'Позначка часу (TSP)'}:</b> <span color='#1e7e34'>🕒 {esc(tsp_str)} ({esc(sub)})</span>")
        else:
            lines.append(f"<b>{'Timestamp (TSP)' if is_en else 'Позначка часу (TSP)'}:</b> ⚠️ {'No standalone TSP timestamp' if is_en else 'Відсутня окрема мітка TSP'}")

        sig_lvl = res.get("signature_level") or ("CAdES-T" if res.get("has_tsp") else "CAdES-BES")
        if res.get("has_ltv"):
            ltv_desc = f"🔏 {esc(sig_lvl)} (Archival 25+ years)" if is_en else f"🔏 {esc(sig_lvl)} (Архівне зберігання 25+ років)"
            lines.append(f"<b>{'Archival LTV' if is_en else 'Архівна мітка (LTV)'}:</b> <span color='#1e7e34'>{ltv_desc}</span>")
        else:
            lines.append(f"<b>{'Archival LTV' if is_en else 'Архівна мітка (LTV)'}:</b> {esc(sig_lvl)}")

        if res.get("manifest_verified") is True:
            m_ok = "✅ All files match checksums" if is_en else "✅ Усі файли відповідають контрольним сумам"
            lines.append(f"<b>{'Archive integrity' if is_en else 'Цілісність архіву'}:</b> <span color='#1e7e34'>{m_ok}</span>")
        elif res.get("manifest_verified") is False:
            m_err = "❌ CORRUPTED (checksum mismatch)" if is_en else "❌ ПОШКОДЖЕНО (контрольні суми не збігаються)"
            lines.append(f"<b>{'Archive integrity' if is_en else 'Цілісність архіву'}:</b> <span color='#d9534f'>{m_err}</span>")

        if res.get("signed_files"):
            is_asice = True
            asice_files = res.get("signed_files")
            s_hdr = f"Signed files ({len(asice_files)}):" if is_en else f"Підписані файли ({len(asice_files)}):"
            lines.append(f"\n<b>📦 {s_hdr}</b>")
            for sf in asice_files:
                lines.append(f"  • {esc(sf)}")

        certs = res.get("signer_certs", [])
        for c_idx, c in enumerate(certs, 1):
            subj = c.get("subject", {})
            iss = c.get("issuer", {})

            full_name = subj.get("cn") or f"{subj.get('surname', '')} {subj.get('given_name', '')}".strip() or "—"
            drfo = subj.get("drfo") or subj.get("serial_number") or "—"
            ca_name = iss.get("cn") or iss.get("organization") or "—"
            if is_en:
                q_type = "🟢 Qualified Electronic Signature (QES)" if c.get("is_qes") else "🟡 Advanced Electronic Signature (AES)"
            else:
                q_type = "🟢 Кваліфікований електронний підпис (КЕП)" if c.get("is_qes") else "🟡 Удосконалений електронний підпис (УЕП)"

            if len(certs) > 1:
                sig_hdr = f"── Signer #{c_idx} ──" if is_en else f"── Підписувач #{c_idx} ──"
                lines.append(f"\n<b>{sig_hdr}</b>")
            else:
                lines.append("")

            lines.append(f"<b>{'Signer' if is_en else 'Підписувач'}:</b> {esc(full_name)}")
            lines.append(f"<b>{'Tax ID (RNOKPP)' if is_en else 'РНОКПП (ІПН)'}:</b> {esc(drfo)}")
            if subj.get("organization") and subj.get("organization") != "ФІЗИЧНА ОСОБА":
                lines.append(f"<b>{'Organization' if is_en else 'Організація'}:</b> {esc(subj.get('organization'))}")
            if subj.get("edrpou"):
                lines.append(f"<b>{'USREOU' if is_en else 'ЄДРПОУ'}:</b> {esc(subj.get('edrpou'))}")
            lines.append(f"<b>{'CA (TSP)' if is_en else 'КНЕДП (АЦСК)'}:</b> {esc(ca_name)}")
            lines.append(f"<b>{'Signature type' if is_en else 'Тип підпису'}:</b> {esc(q_type)}")

            val_from = format_iso_time(c.get("valid_from"))
            val_to = format_iso_time(c.get("valid_to"))
            lines.append(f"<b>{'Certificate validity' if is_en else 'Дія сертифіката'}:</b> {'from' if is_en else 'з'} {esc(val_from)} {'to' if is_en else 'до'} {esc(val_to)}")

        chain = res.get("cert_chain") or []
        if len(chain) > 1:
            chain_title = "🔗 Certificate Trust Chain:" if is_en else "🔗 Ланцюжок сертифікатів довіри:"
            lines.append(f"\n<b>{chain_title}</b>")
            for ch_idx, ch_cert in enumerate(chain, 1):
                ch_cn = (ch_cert.get("subject") or {}).get("cn") or (ch_cert.get("subject") or {}).get("organization") or "—"
                role = ch_cert.get("chain_role", "")
                icon = "👤" if role == "SIGNER" else ("🇺🇦" if role == "ROOT_CA" else "🏛️")
                lines.append(f"  <tt>[{ch_idx}]</tt> {icon} {esc(ch_cn)}")

    pango_text = "\n".join(lines)

    report_title = f"QES Verification Report — {os.path.basename(file_path)}" if is_en else f"Протокол перевірки КЕП — {os.path.basename(file_path)}"
    close_btn = "Close" if is_en else "Закрити"
    pdf_btn = "📄 Save PDF Protocol" if is_en else "📄 Зберегти PDF-протокол"
    extract_btn = "Extract Documents" if is_en else "Видобути документи"

    while True:
        cmd = [
            "zenity", "--info",
            f"--title={report_title}",
            f"--text={pango_text}",
            f"--ok-label={close_btn}",
            "--icon-name=application-certificate",
            "--width=660",
            "--height=480",
        ]
        user_icon = os.path.expanduser("~/.local/share/icons/Papirus/48x48/mimetypes/application-certificate.svg")
        sys_icon = "/usr/share/icons/Papirus/48x48/mimetypes/application-certificate.svg"
        if os.path.isfile(user_icon):
            cmd.append(f"--window-icon={user_icon}")
        elif os.path.isfile(sys_icon):
            cmd.append(f"--window-icon={sys_icon}")
        cmd.extend([f"--extra-button={pdf_btn}"])
        if is_asice:
            cmd.extend([f"--extra-button={extract_btn}"])
        cmd.extend(["--extra-button=📖 Help / Довідка"])

        proc = subprocess.run(cmd, stdout=subprocess.PIPE, text=True)
        clicked = proc.stdout.strip()

        if clicked == pdf_btn:
            chosen_lang = ask_protocol_lang_gui(lang)
            if not chosen_lang:
                continue
            try:
                saved_pdf = generate_pdf_protocol(results, file_path, protocol_lang=chosen_lang)
                is_proto_en = (chosen_lang == "en")
                notif_title = "📄 PDF Protocol Created" if is_proto_en else "📄 PDF-протокол сформовано"
                notif_msg = f"Saved to:\n{os.path.basename(saved_pdf)}" if is_proto_en else f"Збережено у файл:\n{os.path.basename(saved_pdf)}"
                if shutil.which("notify-send"):
                    subprocess.run(["notify-send", "-a", "QES Tools", "-i", "application-pdf", notif_title, notif_msg])
                if shutil.which("xdg-open"):
                    subprocess.Popen(["xdg-open", saved_pdf])
            except Exception as err:
                err_title = "Protocol Error" if is_en else "Помилка формування протоколу"
                subprocess.run(["zenity", "--error", "--no-markup", f"--title={err_title}", f"--text={str(err)}"])
            continue
        elif clicked == extract_btn:
            dlg_title = "Select folder to extract files" if is_en else "Оберіть папку для видобування файлів"
            dest_dir = subprocess.run(
                ["zenity", "--file-selection", "--directory", f"--title={dlg_title}"],
                stdout=subprocess.PIPE, text=True
            ).stdout.strip()
            if dest_dir:
                extract_asice_files(file_path, dest_dir)
                notif_title = "📦 Files Extracted" if is_en else "📦 Файли видобуто"
                notif_msg = f"Documents successfully extracted to:\n{dest_dir}" if is_en else f"Документи успішно видобуто у:\n{dest_dir}"
                if shutil.which("notify-send"):
                    subprocess.run([
                        "notify-send", "-a", "QES Tools", "-i", "folder",
                        notif_title, notif_msg
                    ])
                elif shutil.which("zenity"):
                    subprocess.run(["zenity", "--notification", f"--text={notif_title}: {notif_msg}"])
                subprocess.Popen(["xdg-open", dest_dir])
            continue
        elif "Help" in clicked or "Довідка" in clicked:
            show_help_dialog()
            continue
        else:
            break


def delegate_to_qes_cert(file_path: str, args: argparse.Namespace) -> int:
    """Делегує аналіз сертифіката спеціалізованому модулю qes-cert."""
    qes_cert_bin = shutil.which("qes-cert")
    if not qes_cert_bin:
        sibling = Path(__file__).resolve().parent / "qes-cert"
        if sibling.exists():
            qes_cert_bin = str(sibling)
        else:
            local_bin = Path.home() / ".local" / "bin" / "qes-cert"
            if local_bin.exists():
                qes_cert_bin = str(local_bin)

    if not qes_cert_bin:
        sys.stderr.write("Помилка: модуль 'qes-cert' не знайдено для перегляду сертифіката.\n")
        return 1

    cmd = [qes_cert_bin]
    if args.json:
        cmd.append("--json")
    if args.gui:
        cmd.append("--gui")
    if getattr(args, "no_color", False):
        cmd.append("--no-color")
    cmd.append(file_path)

    try:
        proc = subprocess.run(cmd)
        return proc.returncode
    except Exception as e:
        sys.stderr.write(f"Помилка виклику qes-cert: {e}\n")
        return 1


def main():
    is_en = (get_qes_lang() == "en")
    ver_str = "1.0.25"
    parser = argparse.ArgumentParser(
        description=f"""================================================================================
  qes-verify — {"Ukrainian & EU QES/AES validator (.p7s, .asice, .pdf)" if is_en else "автономний валідатор КЕП/УЕП (.p7s, .asice, .pdf)"}
  {"Version" if is_en else "Версія"} {ver_str} | 100% Offline-First | {"Legal Privilege Protected" if is_en else "Захист адвокатської таємниці"}
================================================================================

{"DESCRIPTION:" if is_en else "ОПИС:"}
  {"Validates qualified and advanced electronic signatures (QES/AES)," if is_en else "Перевіряє справжність кваліфікованих та удосконалених електронних підписів (КЕП/УЕП),"}
  {"recognizes certificates of all Ukrainian accredited QTSPs (CA), verifies" if is_en else "розпізнає сертифікати всіх акредитованих центрів України (КНЕДП/АЦСК), перевіряє"}
  {"trusted TSP timestamps, extracts signed files, with zero telemetry." if is_en else "мітку точного часу TSP, витягує підписані файли та не відправляє жодних даних у мережу."}
  {"Also generates official printable PDF Verification & Trust Chain Protocols." if is_en else "Також формує офіційний друкований PDF-протокол перевірки КЕП із ланцюжком сертифікатів."}""",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""ПРИКЛАДИ КОМАНД / EXAMPLES:

  1. PDF with embedded PAdES signature (visual stamp + QR code):
     $ qes-verify statement_signed.pdf

  2. Generate official PDF Verification Protocol (with CA Trust Chain, UA or EN):
     $ qes-verify --protocol --lang ua statement_signed.pdf
     $ qes-verify --protocol --lang en statement_signed.pdf

  3. Detached signature (.p7s):
     $ qes-verify contract.pdf.p7s

  4. Verify matching pair [document + detached signature]:
     $ qes-verify contract.pdf contract.pdf.p7s

  5. European container archive ASiC-E (.asice):
     $ qes-verify legal_bundle.asice

  6. Extract signed documents from ASiC-E container:
     $ qes-verify -x /home/attor/Documents legal_bundle.asice

  7. Inspect public certificate (.cer) or certificate chain bundle (.p7b):
     $ qes-verify cert.cer
     $ qes-verify --gui mono.p7b

  8. Machine-readable JSON output for automated scripting:
     $ qes-verify --json statement_signed.pdf

  9. Display visual inspection dialog in GNOME (Zenity):
     $ qes-verify --gui statement_signed.pdf
================================================================================"""
    )
    parser.add_argument("files", nargs="*", default=[], help="File path(s) to signature (.p7s, .asice, .pdf), certificate (.cer, .p7b) or [document signature] pair" if is_en else "Шлях до файлу(-ів) підпису (.p7s, .asice, .pdf), сертифікатів (.cer, .p7b) або пари [документ підпис]")
    parser.add_argument("-j", "--json", action="store_true", help="Output results in structured JSON format" if is_en else "Вивести результат у структурованому форматі JSON")
    parser.add_argument("-p", "--protocol", "--pdf-report", dest="protocol", action="store_true", help="Generate official PDF Verification & Trust Chain Protocol" if is_en else "Сформувати офіційний PDF-протокол перевірки КЕП та ланцюжка сертифікатів")
    parser.add_argument("-l", "--lang", default=None, help="Language for generated PDF protocol (ua/uk or en)" if is_en else "Мова формування PDF-протоколу (ua/uk або en)")
    parser.add_argument("-o", "--output", default=None, help="Output path for generated PDF protocol" if is_en else "Шлях збереження сформованого PDF-протоколу")
    parser.add_argument("-x", "--extract", nargs="?", const=".", default=None, help="Extract signed documents to target directory" if is_en else "Видобути підписаний документ у вказану папку (за замовчуванням: поточна)")
    parser.add_argument("--gui", action="store_true", help="Display visual verification report dialog (Zenity)" if is_en else "Показати результат у графічному діалоговому вікні GNOME (Zenity)")
    parser.add_argument("--no-color", action="store_true", help="Disable colored output in terminal" if is_en else "Вимкнути кольоровий вивід у терміналі")

    args = parser.parse_args()

    if not args.files:
        if args.gui:
            cmd_sel = [
                "zenity", "--file-selection",
                f"--title={'Select document or signature to verify QES' if is_en else 'Оберіть документ або підпис для перевірки КЕП'}",
                f"--file-filter={'Documents and Signatures (*.pdf *.p7s *.asice *.cer) | *.pdf *.p7s *.asice *.asics *.cer *.crt *.der *.pem *.p7b' if is_en else 'Документи та підписи (*.pdf *.p7s *.asice *.cer) | *.pdf *.p7s *.asice *.asics *.cer *.crt *.der *.pem *.p7b'}",
                f"--file-filter={'All files (*.*) | *.*' if is_en else 'Усі файли (*.*) | *.*'}",
            ]
            sel_res = subprocess.run(cmd_sel, stdout=subprocess.PIPE, text=True)
            chosen = sel_res.stdout.strip()
            if not chosen:
                sys.exit(0)
            args.files = [chosen]
        else:
            parser.print_help()
            sys.exit(1)

    use_color = not args.no_color and sys.stdout.isatty() and not args.json and not args.gui

    target_files = []
    # Identify files
    for item in args.files:
        p = Path(item)
        if not p.exists():
            sys.stderr.write(f"Error: file '{item}' not found.\n" if is_en else f"Помилка: файл '{item}' не знайдено.\n")
            sys.exit(1)
        target_files.append(str(p.resolve()))

    # If two files were given (e.g. [doc.pdf, doc.pdf.p7s]), prioritize the signature file
    sig_files = []
    for f in target_files:
        ext = Path(f).suffix.lower()
        if ext in [".p7s", ".p7b", ".asice", ".asics", ".cer", ".crt", ".der", ".pem"]:
            sig_files.append(f)
        elif ext == ".pdf":
            sig_files.append(f)

    if not sig_files:
        sig_files = target_files

    all_results: List[Dict[str, Any]] = []
    overall_ok = True

    for sf in sig_files:
        ext = Path(sf).suffix.lower()
        if ext in [".cer", ".crt", ".der", ".pem"]:
            ret = delegate_to_qes_cert(sf, args)
            if ret != 0:
                overall_ok = False
            continue

        res_list: List[Dict[str, Any]] = []

        if ext in [".asice", ".asics"]:
            res_list = inspect_asice(sf)
            if args.extract:
                extracted = extract_asice_files(sf, args.extract)
                if not args.json and not args.gui and extracted:
                    msg = f"📦 Extracted signed files to '{args.extract}': {', '.join(map(os.path.basename, extracted))}\n" if is_en else f"📦 Видобуто підписані файли до '{args.extract}': {', '.join(map(os.path.basename, extracted))}\n"
                    print(colorize(msg, CLR_GREEN, use_color))
        elif ext in [".p7s", ".p7b"]:
            res_list = inspect_p7s(sf)
        elif ext == ".pdf":
            res_list = inspect_pades_pdf(sf)
            if not res_list:
                if not args.json and not args.gui:
                    msg = f"⚠️ No embedded PAdES signature found in '{os.path.basename(sf)}'.\n" if is_en else f"⚠️ У файлі '{os.path.basename(sf)}' не знайдено вбудованого підпису PAdES.\n"
                    print(colorize(msg, CLR_YELLOW, use_color))
                continue
        else:
            # Fallback attempt p7s
            res_list = inspect_p7s(sf)

        for idx, r in enumerate(res_list, 1):
            all_results.append(r)
            if not args.json and not args.gui:
                ok = print_cli_report(r, use_color, sig_index=idx, total_sigs=len(res_list))
                if not ok:
                    overall_ok = False

    if all_results:
        primary_file = sig_files[0] if sig_files else target_files[0]
        if args.protocol:
            proto_lang = args.lang
            if proto_lang:
                proto_lang = proto_lang.strip().lower()
                if proto_lang == "ua":
                    proto_lang = "uk"
            elif args.gui:
                proto_lang = ask_protocol_lang_gui()
                if not proto_lang:
                    sys.exit(0)
            out_proto = generate_pdf_protocol(all_results, primary_file, args.output, protocol_lang=proto_lang)
            overall_ok = True
            if not args.json:
                msg = f"📄 PDF Verification Protocol saved to: {out_proto}" if is_en else f"📄 PDF-протокол перевірки КЕП збережено у: {out_proto}"
                print(colorize(msg, CLR_GREEN + CLR_BOLD, use_color))
        if args.gui and not args.protocol:
            show_gui_report(all_results, primary_file)
        elif args.json:
            print(json.dumps(all_results, indent=2, ensure_ascii=False))

    sys.exit(0 if overall_ok else 1)


if __name__ == "__main__":
    main()
